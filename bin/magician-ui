#!/usr/bin/env python3
"""magician-ui — manage the Magician CLI status line and magician's stored preferences.

Runs only when you (or the /statusline skill, on your request) invoke it; no hook calls it. The one
Claude Code settings file it edits is ~/.claude/settings.json ($MAGICIAN_SETTINGS overrides), and only
the `statusLine` key, plus — for `cleanup` — the permission entries on the fixed list earlier magician
versions used, when cli-ui.json records that they added them.

Subcommands:
  status                     Show the bar's state and components, whether settings.json runs it, and
                             any permission entries or data files left over from earlier versions.
  enable [--all|--only a,b]  Copy the renderer to ~/.claude/magician/statusline.py and point
                             `statusLine` in settings.json at it. Records the chosen components;
                             with no flag or component list it keeps the saved ones (all, the first
                             time).
  set <a,b,c>                Change which components show (cli-ui.json only; settings.json untouched).
  default                    Same as `enable --all`.
  disable [--purge [--force]]
                             Remove magician's `statusLine` (only if it runs magician; a status line of
                             your own is left alone). --purge also deletes the renderer copy, the
                             status/ marker folder and cli-ui.json (run it before uninstalling, after
                             `cleanup`: cleanup needs cli-ui.json's record of what 4.14 and earlier
                             added, so --purge refuses while cleanup still has recorded entries to
                             remove; --force deletes the record anyway and leaves those entries).
  cleanup                    Remove what magician 4.14 and earlier wrote on its own: its
                             permissions.allow rules and `permissions.defaultMode: "auto"`, each only
                             when cli-ui.json records magician added it, the unused
                             CLAUDE_CODE_ENABLE_AUTO_MODE env key, and obsolete data files. Keeps the
                             newest 3 settings backups (mode 0600) and clears the record.
  lore [on|off|status]       Turn the bundled lore on or off (cli-ui.json only).
  voice [warrior|scribe|bard|status]
                             Set the output-brevity level (cli-ui.json only).
  allow --off                Same as `cleanup`.
  automode --off             Same as `cleanup`.
  reconcile                  No longer used; prints a pointer to `cleanup`.

A subcommand given an argument it doesn't take, and `enable` or `set` given no known component, stops
without changing anything; -h or --help after any subcommand prints this text.

magician no longer adds permission rules or sets the permission mode, so `allow` and `automode`
without --off change nothing. Add rules with /permissions; pick a mode with Shift+Tab or
`claude --permission-mode <mode>`.

SAFETY: settings.json edits go through _edit_settings() — read, json.load, mutate a copy,
serialize+re-validate, back up (mode 0600, newest 3 kept), atomic os.replace. Any failure aborts without
touching the live file; an edit that changes nothing writes nothing.

Components: context (bar+%+tokens) · rot (⚠/🔴 glyph) · spark (token-flow sparkline) ·
            meta (model·git·cost) · skill (active skill/workflow/loop) ·
            effort (🧠 live reasoning effort — low/medium/high/xhigh/max — or the magician
                    mode you set, e.g. ultracode; from Claude Code's effort.level on stdin) ·
            lore (📚 bundled-lore state) · voice (🗣 output-brevity level).
"""
import sys, os, json, shutil, time, glob, stat, re, copy

HOME = os.environ.get("MAGICIAN_HOME") or os.path.expanduser("~/.claude/magician")
CFG = os.path.join(HOME, "cli-ui.json")
SETTINGS = os.environ.get("MAGICIAN_SETTINGS") or os.path.expanduser("~/.claude/settings.json")
INSTALLED = os.path.join(HOME, "statusline.py")   # stable path, version-independent
STATUS_DIR = os.path.join(HOME, "status")         # per-session markers read by the renderer
ALL = ["context", "rot", "spark", "meta", "skill", "effort", "lore", "voice"]
MARK = "magician"   # substring used to recognise our own statusLine entry
BACKUP_TAG = ".bak-magician-ui-"   # settings.json.bak-magician-ui-<YYYYmmdd-HHMMSS>[-n]
KEEP_BACKUPS = 3

# Output-brevity levels (least → most wordy). warrior = leanest but complete,
# scribe = the default (leaner than usual), bard = standard/native verbosity.
# SessionStart adds a brevity note for warrior/scribe (none for bard).
VOICE_LEVELS = ["warrior", "scribe", "bard"]
VOICE_DEFAULT = "scribe"

# Every permissions.allow rule magician 4.2 to 4.14 merged into ~/.claude/settings.json (this list is
# the union of all versions). Nothing adds these any more; they are kept only so `cleanup` can remove
# them. Each merge also wrote "allow": "on" to cli-ui.json, and `cleanup` removes these rules only while
# that record is there. A matching rule the user also wrote can't be told apart from magician's then.
READONLY_ALLOW = [
    "Read", "Grep", "Glob", "LS", "TaskOutput",
    "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
    "Bash(git rev-parse:*)", "Bash(git branch:*)", "Bash(git ls-files:*)", "Bash(git blame:*)",
    "Bash(git remote:*)", "Bash(git fetch:*)", "Bash(git describe:*)", "Bash(git rev-list:*)",
    "Bash(git shortlog:*)", "Bash(git for-each-ref:*)", "Bash(git show-ref:*)", "Bash(git ls-tree:*)",
    "Bash(git cat-file:*)", "Bash(git merge-base:*)", "Bash(git name-rev:*)", "Bash(git worktree list:*)",
    "Bash(git stash list:*)",
    "Bash(kg:*)", "Bash(ctx:*)", "Bash(magician-scan:*)",
    "Bash(jira get:*)", "Bash(jira search:*)", "Bash(jira myself:*)", "Bash(jira mine:*)",
    "Bash(jira sprint:*)", "Bash(jira comments:*)", "Bash(jira board:*)", "Bash(jira transitions:*)",
    "Bash(jira url:*)", "Bash(jira raw GET:*)",
    "Bash(confluence whoami:*)", "Bash(confluence get:*)", "Bash(confluence search:*)", "Bash(confluence raw GET:*)",
    "Bash(npm test:*)", "Bash(npm run test:*)", "Bash(npm run lint:*)", "Bash(npm run typecheck:*)",
    "Bash(npm run build:*)", "Bash(npx tsc:*)", "Bash(yarn test:*)", "Bash(yarn lint:*)",
    "Bash(pnpm test:*)", "Bash(pnpm lint:*)", "Bash(jest:*)", "Bash(vitest:*)", "Bash(pytest:*)",
    "Bash(go test:*)", "Bash(cargo test:*)",
    "Bash(gh pr view:*)", "Bash(gh pr checks:*)", "Bash(gh pr diff:*)", "Bash(gh pr list:*)",
    "Bash(gh run view:*)", "Bash(gh issue view:*)", "Bash(gh issue list:*)", "Bash(gh repo view:*)",
    "Bash(gh search:*)",
]

# Broader grants 4.2 and 4.3 added. From 4.4.0 every merge stripped them, so when the record names
# 4.4.0 or later, one of these in settings.json was added by the user and `cleanup` keeps it.
STALE_ALLOW = ["Bash(jira:*)", "Bash(confluence:*)"]

OURS = frozenset(READONLY_ALLOW) | frozenset(STALE_ALLOW)

# Env key magician 4.x once wrote to settings.json; Claude Code has ignored it since v2.1.207.
AUTOMODE_ENV_KEY = "CLAUDE_CODE_ENABLE_AUTO_MODE"

# Data files only removed features wrote (read tracker, prompt fingerprints, the old global start stamp,
# transcript-derived compaction capsules, per-session nudge flags). `cleanup` deletes these exact names
# under each plugin data folder and nothing else.
LEGACY_DATA = [
    "access-patterns.json",
    "patterns.json",
    "session-start-time.txt",
    "projects/*/capsule.md",
    "projects/*/capsule.json",
    "ctx/*.resume",
    "ctx/*.kgnudge",
    "ctx/*mcpnudge*",
]


def die(msg):
    sys.stderr.write(f"magician-ui: {msg}\n")
    sys.exit(1)


def _now():
    return time.strftime("%Y-%m-%dT%H:%M:%S")


# ---------------- config ----------------
def load_cfg():
    try:
        with open(CFG, encoding="utf-8") as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def save_cfg(d):
    try:
        os.makedirs(HOME, exist_ok=True)
        tmp = CFG + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(d, f, indent=2)
        os.replace(tmp, CFG)
    except Exception as e:
        die(f"could not write config {CFG}: {e}")


def parse_components(args):
    """Components named by --all, --only a,b or a bare list; [] when none of the names is a component."""
    only, allf = None, False
    for a in args:
        if a == "--all":
            allf = True
        elif a.startswith("--only"):
            if "=" in a:
                only = a.split("=", 1)[1]
        elif only is None and not a.startswith("-"):
            only = a  # bare comma-list, e.g. `set context,rot` or `--only context,rot`
    if allf:
        return list(ALL)
    picked = [c.strip() for c in (only or "").replace(" ", ",").split(",") if c.strip()]
    return [c for c in picked if c in ALL]


# --------------- renderer install ---------------
def _version_key(path):
    """Sort key for .../magician/<version>/bin/magician-statusline — numeric, so 4.15 sorts after 4.9."""
    ver = os.path.basename(os.path.dirname(os.path.dirname(path)))
    return [int(x) if x.isdigit() else -1 for x in re.split(r"[.+-]", ver)]


def _find_renderer():
    # sibling of this CLI in the plugin bin/ (works when invoked via PATH)
    here = os.path.dirname(os.path.realpath(sys.argv[0] or __file__))
    cand = os.path.join(here, "magician-statusline")
    if os.path.isfile(cand):
        return cand
    # fallback: newest version in the plugin cache
    hits = glob.glob(os.path.expanduser(
        "~/.claude/plugins/cache/*/magician/*/bin/magician-statusline"))
    hits.sort(key=_version_key)
    return hits[-1] if hits else None


def install_renderer():
    src = _find_renderer()
    if not src:
        die("could not locate bin/magician-statusline to install")
    os.makedirs(HOME, exist_ok=True)
    tmp = INSTALLED + ".tmp"
    shutil.copyfile(src, tmp)
    os.chmod(tmp, 0o755)
    os.replace(tmp, INSTALLED)
    return src


def _plugin_version():
    """Version from the plugin.json next to this CLI (installPath/.claude-plugin/plugin.json)."""
    try:
        root = os.path.dirname(os.path.dirname(os.path.realpath(sys.argv[0] or __file__)))
        with open(os.path.join(root, ".claude-plugin", "plugin.json"), encoding="utf-8") as f:
            return str((json.load(f) or {}).get("version", "") or "")
    except Exception:
        return ""


# --------------- settings.json: read, backups, safe edit ---------------
def _read_settings():
    """settings.json as a dict, or {} when missing/unreadable (read-only callers only)."""
    try:
        with open(SETTINGS, encoding="utf-8") as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def _is_regular(path):
    try:
        return stat.S_ISREG(os.lstat(path).st_mode)
    except OSError:
        return False


def _backups():
    """Existing settings backups made by this CLI, oldest first."""
    prefix = SETTINGS + BACKUP_TAG

    def key(p):
        parts = p[len(prefix):].split("-")
        n = int(parts[2]) if len(parts) > 2 and parts[2].isdigit() else 0
        return ("-".join(parts[:2]), n, p)

    return sorted((p for p in glob.glob(glob.escape(prefix) + "*") if _is_regular(p)), key=key)


def _backup_settings():
    """Copy settings.json to a new mode-0600 backup next to it; returns the backup path."""
    stamp = time.strftime("%Y%m%d-%H%M%S")
    bak, n = SETTINGS + BACKUP_TAG + stamp, 1
    while os.path.lexists(bak):
        bak, n = f"{SETTINGS}{BACKUP_TAG}{stamp}-{n}", n + 1
    with open(SETTINGS, "rb") as src:
        raw = src.read()
    fd = os.open(bak, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(raw)
    os.chmod(bak, 0o600)
    return bak


def _prune_backups(keep=KEEP_BACKUPS):
    """Keep the newest `keep` settings backups (each chmod 0600); delete the rest. Returns #deleted."""
    baks = _backups()
    cut = max(0, len(baks) - keep)
    removed = 0
    for p in baks[:cut]:
        try:
            os.remove(p)
            removed += 1
        except OSError:
            pass
    for p in baks[cut:]:
        try:
            os.chmod(p, 0o600)
        except OSError:
            pass
    return removed


def _edit_settings(mutate):
    """Apply `mutate` to a copy of settings.json and write it back safely. Returns True if the file was
    rewritten, False if the mutation changed nothing (then nothing is written or backed up)."""
    exists = True
    try:
        with open(SETTINGS, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        data, exists = {}, False
    except Exception as e:
        die(f"{SETTINGS} is not valid JSON ({e}); refusing to modify it")
    if not isinstance(data, dict):
        die(f"{SETTINGS} is not a JSON object; refusing to modify it")

    new = copy.deepcopy(data)
    mutate(new)
    if new == data:
        return False
    text = json.dumps(new, indent=2, ensure_ascii=False)
    json.loads(text)  # re-validate before writing anything

    target = os.path.realpath(SETTINGS)   # write through a symlinked settings.json, don't replace the link
    os.makedirs(os.path.dirname(target), exist_ok=True)
    mode = 0o600
    if exists:
        mode = stat.S_IMODE(os.stat(target).st_mode)
        _backup_settings()
    tmp = target + ".tmp-magician-ui"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text + "\n")
    os.chmod(tmp, mode)
    with open(tmp, encoding="utf-8") as f:
        json.load(f)  # validate the temp file on disk
    os.replace(tmp, target)
    _prune_backups()
    return True


def _statusline_cmd():
    return f'python3 "{INSTALLED}"'


def _our_statusline(d):
    sl = d.get("statusLine") if isinstance(d, dict) else None
    if not isinstance(sl, dict):
        return False
    cmd = str(sl.get("command", ""))
    return INSTALLED in cmd or MARK in cmd


def _has_any_statusline(d):
    return isinstance(d, dict) and isinstance(d.get("statusLine"), dict) and bool(d.get("statusLine"))


# --------------- leftovers from earlier versions ---------------
def _matching_allow_rules(d):
    """permissions.allow entries in settings `d` that match a rule earlier magician versions added."""
    perms = d.get("permissions") if isinstance(d, dict) else None
    allow = perms.get("allow") if isinstance(perms, dict) else None
    if not isinstance(allow, list):
        return []
    return [r for r in allow if isinstance(r, str) and r in OURS]


def _allow_is_ours(cfg):
    """True only if cli-ui.json records that magician merged its allow list (4.2 to 4.14 wrote "on")."""
    return cfg.get("allow") == "on"


def _allow_rules_split(d, cfg):
    """(removed, kept): the matching allow entries `cleanup` removes and the ones it keeps."""
    match = _matching_allow_rules(d)
    if not _allow_is_ours(cfg):
        return [], match
    m = re.match(r"(\d+)\.(\d+)", str(cfg.get("allowVersion", "")))
    stripped_stale = bool(m) and (int(m.group(1)), int(m.group(2))) >= (4, 4)
    kept = [r for r in match if stripped_stale and r in STALE_ALLOW]
    return [r for r in match if r not in kept], kept


def _auto_mode_is_ours(d, cfg):
    """True only if defaultMode is "auto" AND cli-ui.json records that magician set it."""
    perms = d.get("permissions") if isinstance(d, dict) else None
    return cfg.get("automode") == "on" and isinstance(perms, dict) and perms.get("defaultMode") == "auto"


def _has_automode_env(d):
    env = d.get("env") if isinstance(d, dict) else None
    return isinstance(env, dict) and AUTOMODE_ENV_KEY in env


def _permission_leftovers(d, cfg):
    """Human-readable list of the settings entries `cleanup` would remove."""
    out = []
    n = len(_allow_rules_split(d, cfg)[0])
    if n:
        out.append(f"{n} allow rule(s)")
    if _auto_mode_is_ours(d, cfg):
        out.append('defaultMode "auto"')
    if _has_automode_env(d):
        out.append(f"env {AUTOMODE_ENV_KEY}")
    return out


def _data_dirs():
    """Plugin data folders that may hold files from earlier versions: $MAGICIAN_DATA, $CLAUDE_PLUGIN_DATA
    and the legacy ~/.local/share/magician — each listed once, and only if it exists."""
    seen, out = set(), []
    for d in (os.environ.get("MAGICIAN_DATA"), os.environ.get("CLAUDE_PLUGIN_DATA"),
              os.path.expanduser("~/.local/share/magician")):
        if not d or not os.path.isdir(d):
            continue
        real = os.path.realpath(d)
        if real not in seen:
            seen.add(real)
            out.append(d)
    return out


def _legacy_files():
    """Obsolete data files (exact LEGACY_DATA names) present in the plugin data folders."""
    seen, hits = set(), []
    for base in _data_dirs():
        for pat in LEGACY_DATA:
            for p in sorted(glob.glob(os.path.join(glob.escape(base), *pat.split("/")))):
                try:
                    mode = os.lstat(p).st_mode
                except OSError:
                    continue
                key = (os.path.realpath(os.path.dirname(p)), os.path.basename(p))
                if (stat.S_ISREG(mode) or stat.S_ISLNK(mode)) and key not in seen:
                    seen.add(key)
                    hits.append(p)
    return hits


# --------------- commands ---------------
def cmd_status(_args):
    cfg = load_cfg()
    st = cfg.get("state")
    st = st if st in ("enabled", "disabled") else "not enabled"
    comps = cfg.get("components")
    comps = comps if isinstance(comps, list) and comps else ALL
    s = _read_settings()
    wired = _our_statusline(s)
    print(f"state:       {st}")
    print(f"components:  {', '.join(str(c) for c in comps)}")
    print(f"renderer:    {INSTALLED} {'(present)' if os.path.exists(INSTALLED) else '(missing)'}")
    print(f"settings:    {SETTINGS} — statusLine {'runs magician' if wired else 'does not run magician'}")
    print(f"lore:        {'disabled' if cfg.get('lore') == 'disabled' else 'enabled'} (`magician-ui lore on|off`)")
    print(f"voice:       {cfg.get('voice', VOICE_DEFAULT)} (output brevity: warrior<scribe<bard; default scribe — `magician-ui voice <level>`)")
    left = _permission_leftovers(s, cfg)
    kept = _allow_rules_split(s, cfg)[1]
    if left:
        print(f"permissions: {', '.join(left)} added by an earlier magician version — `magician-ui cleanup` removes them")
    elif not kept:
        print("permissions: no entries from earlier magician versions")
    if kept:
        print(f"{'             ' if left else 'permissions: '}{len(kept)} allow rule(s) match magician's old list, "
              "but magician has no record of adding them — `magician-ui cleanup` leaves them")
    old = _legacy_files()
    if old:
        print(f"old data:    {len(old)} obsolete file(s) from earlier versions — `magician-ui cleanup` removes them")


def _saved_components(cfg):
    """Valid components recorded in cli-ui.json, or ALL when none are saved."""
    comps = cfg.get("components")
    comps = [c for c in comps if c in ALL] if isinstance(comps, list) else []
    return comps or list(ALL)


def cmd_enable(args):
    cfg = load_cfg()
    # A plain `enable` (the refresh step after an update) keeps the components chosen earlier with
    # `enable --only` or `set`. --all, --only or a bare list chooses them again.
    chosen = any(a == "--all" or a.startswith("--only") or not a.startswith("-") for a in args)
    comps = parse_components(args) if chosen else _saved_components(cfg)
    if not comps:  # `enable help`, a typo, a bare --only: stop rather than reset to every component
        die(f"no component named in '{' '.join(args)}'; choose from: {', '.join(ALL)}. Nothing was changed.")
    src = install_renderer()
    _edit_settings(lambda d: d.__setitem__(
        "statusLine", {"type": "command", "command": _statusline_cmd(), "padding": 0}))
    cfg.update({"state": "enabled", "components": comps, "installedFrom": src,
                "version": _plugin_version(), "enabledAt": _now(), "updatedAt": _now()})
    save_cfg(cfg)
    print(f"Magician CLI UI enabled — components: {', '.join(comps)}.")
    print(f"Renderer copied to {INSTALLED}; `statusLine` in {SETTINGS} now runs it.")
    print("The bar appears within a message or two (settings hot-reload). "
          "Change parts with `magician-ui set <list>` and turn off with `magician-ui disable`. Before "
          "uninstalling magician, run `magician-ui cleanup`, then `magician-ui disable --purge`.")


def cmd_set(args):
    comps = parse_components(args)
    if not comps:
        die(f"nothing valid to set; choose from: {', '.join(ALL)}. Nothing was changed.")
    cfg = load_cfg()
    cfg["components"] = comps
    cfg["updatedAt"] = _now()
    save_cfg(cfg)
    print(f"Status-line components set to: {', '.join(comps)}.")


def _purge_files():
    """Delete the renderer copy, the status/ marker folder and cli-ui.json. Returns what was removed."""
    removed = []
    for p in (INSTALLED, INSTALLED + ".tmp", CFG, CFG + ".tmp"):
        if os.path.lexists(p) and not os.path.isdir(p):
            try:
                os.remove(p)
                removed.append(p)
            except OSError as e:
                sys.stderr.write(f"magician-ui: could not remove {p}: {e}\n")
    if os.path.islink(STATUS_DIR):
        try:
            os.remove(STATUS_DIR)
            removed.append(STATUS_DIR)
        except OSError as e:
            sys.stderr.write(f"magician-ui: could not remove {STATUS_DIR}: {e}\n")
    elif os.path.isdir(STATUS_DIR):
        shutil.rmtree(STATUS_DIR, ignore_errors=True)
        if not os.path.exists(STATUS_DIR):
            removed.append(STATUS_DIR + "/")
        else:
            sys.stderr.write(f"magician-ui: could not fully remove {STATUS_DIR}\n")
    return removed


def cmd_disable(args):
    purge = any(a in ("--purge", "purge") for a in args)
    force = "--force" in args
    if force and not purge:
        die("--force only goes with --purge; nothing was changed.")

    def rm(d):
        if _our_statusline(d):
            d.pop("statusLine", None)

    cur = _read_settings()
    cfg = load_cfg()
    # cleanup finds these only through cli-ui.json, so deleting it first would strand them. The env key
    # is found without the record, so it doesn't count.
    if purge and not force and (_allow_rules_split(cur, cfg)[0] or _auto_mode_is_ours(cur, cfg)):
        die("cli-ui.json records permission entries an earlier magician version added to settings.json "
            "(`magician-ui status` lists them), and `magician-ui cleanup` needs that record to remove them. "
            "Run `magician-ui cleanup`, then `magician-ui disable --purge`. To delete the record and keep "
            "the entries, run `magician-ui disable --purge --force`. Nothing was changed.")
    if _has_any_statusline(cur) and not _our_statusline(cur):
        print("Note: your settings.json has a statusLine that does not run magician — leaving it untouched.")
    _edit_settings(rm)
    if purge:
        removed = _purge_files()
        print("Magician CLI UI disabled and its files removed." if removed
              else "Magician CLI UI disabled; no renderer copy, status markers or cli-ui.json were present.")
        for p in removed:
            print(f"  removed {p}")
        print("Re-enable anytime with `magician-ui enable` (lore and voice return to their defaults).")
        return
    cfg["state"] = "disabled"
    cfg["updatedAt"] = _now()
    save_cfg(cfg)
    print("Magician CLI UI disabled. Re-enable anytime with `magician-ui enable`. "
          f"`magician-ui disable --purge` also deletes {INSTALLED}, {STATUS_DIR}/ and {CFG}; before "
          "uninstalling magician, run `magician-ui cleanup` first, then the purge.")


def cmd_cleanup(_args):
    """Remove what magician 4.14 and earlier wrote without being asked each time: its allow rules (only
    when cli-ui.json records magician merged them), defaultMode "auto" (only when cli-ui.json records
    magician set it — never replaced with another mode), the unused auto-mode env key, obsolete data
    files; then prune settings backups to the newest 3."""
    cfg = load_cfg()
    found = {"rules": [], "kept": [], "mode": False, "env": False}

    def mut(d):
        found["rules"], found["kept"] = _allow_rules_split(d, cfg)
        if found["rules"]:
            gone = set(found["rules"])
            d["permissions"]["allow"] = [r for r in d["permissions"]["allow"]
                                         if not (isinstance(r, str) and r in gone)]
        if _auto_mode_is_ours(d, cfg):
            found["mode"] = True
            del d["permissions"]["defaultMode"]
        if _has_automode_env(d):
            found["env"] = True
            d["env"].pop(AUTOMODE_ENV_KEY, None)

    wrote = _edit_settings(mut)
    if wrote:
        print(f"Updated {SETTINGS} (previous version backed up next to it):")
        if found["rules"]:
            print(f"  removed {len(found['rules'])} allow rule(s): {', '.join(found['rules'])}")
        if found["mode"]:
            print('  removed permissions.defaultMode "auto" (Claude Code falls back to its default mode)')
        if found["env"]:
            print(f"  removed env {AUTOMODE_ENV_KEY}")
    elif not found["kept"]:
        print(f"{SETTINGS}: no entries from earlier magician versions; not modified.")
    if found["kept"]:
        print(f"Kept {len(found['kept'])} allow rule(s) that match magician's old list "
              f"({', '.join(found['kept'])}): magician has no record of adding them. "
              "Remove any you don't want with /permissions.")

    # Clearing the records also stops the SessionStart upgrade notice, which reads the same keys.
    if os.path.exists(CFG):
        for k in [k for k in cfg if k.startswith(("allow", "automode"))]:
            cfg.pop(k, None)
        cfg["permissionsCleanedAt"] = _now()
        save_cfg(cfg)

    removed = []
    for p in _legacy_files():
        try:
            os.remove(p)
            removed.append(p)
        except OSError as e:
            sys.stderr.write(f"magician-ui: could not remove {p}: {e}\n")
    if removed:
        print(f"Removed {len(removed)} obsolete data file(s):")
        for p in removed:
            print(f"  {p}")
    else:
        print("No obsolete data files found.")

    pruned = _prune_backups()
    if pruned:
        print(f"Deleted {pruned} older settings backup(s); kept the newest {KEEP_BACKUPS} (mode 0600).")


def cmd_reconcile(_args):
    """Retired: no hook calls magician-ui any more. Kept so an old caller exits cleanly; writes nothing."""
    print("magician-ui reconcile: no longer used; see `magician-ui cleanup`.")


def cmd_default(_args):
    """Reset to the default CLI UI: enabled with ALL components ('back to default')."""
    cmd_enable(["--all"])


OFF_WORDS = ("--off", "off", "disable", "remove")
LORE_ON = ("on", "--on", "enable", "yes", "true", "1")
LORE_OFF = ("off", "--off", "disable", "no", "false", "0")


def _wants_off(args):
    return any(a in OFF_WORDS for a in args)


def cmd_allow(args):
    """`allow --off` is an alias for `cleanup`. Without --off nothing changes: magician no longer adds
    permission rules."""
    if _wants_off(args):
        cmd_cleanup([])
        return
    print("magician no longer adds permission rules; nothing was changed. `magician-ui allow --off` "
          "(same as `magician-ui cleanup`) removes the rules earlier versions added. To pre-approve a "
          "command yourself, use /permissions or choose \"don't ask again\" at a permission prompt.")


def cmd_automode(args):
    """`automode --off` is an alias for `cleanup`. Without --off nothing changes: magician no longer sets
    the permission mode."""
    if _wants_off(args):
        cmd_cleanup([])
        return
    print("magician no longer sets the permission mode; nothing was changed. `magician-ui automode --off` "
          "(same as `magician-ui cleanup`) removes a defaultMode \"auto\" an earlier version set. To pick "
          "a mode yourself: Shift+Tab in a session, `claude --permission-mode <mode>`, or "
          "`permissions.defaultMode` in your own settings.")


def cmd_lore(args):
    """Enable/disable magician's bundled language & database lore (default ENABLED).
    Lore is a baseline BELOW the repo's own rules — turn it off if it conflicts with your local/project
    knowledge or gives wrong judgment. `magician-ui lore` / `lore on` enables; `lore off` disables (the
    SessionStart hook then adds NO lore); `lore status` prints the state. Per-project override: create
    `.magician/lore.off` in a repo (disables lore there only). Env override: MAGICIAN_LORE=0. The bundled
    on/off state lives in cli-ui.json; the status bar's `lore` chip shows it live. Takes effect next session."""
    cfg = load_cfg()
    if args and args[0] in ("status", "--status"):
        st = "disabled" if cfg.get("lore") == "disabled" else "enabled"
        shown = "lore" in (cfg.get("components") or ALL)
        print(f"lore injection:  {st} (default: enabled)")
        print(f"status-bar chip: {'shown' if shown else 'hidden'}  (toggle via `magician-ui set ...,lore`)")
        print("overrides:       per-project `.magician/lore.off` · env `MAGICIAN_LORE=0`")
        return
    if args and args[0] in LORE_OFF:
        cfg["lore"] = "disabled"; save_cfg(cfg)
        print("Magician lore DISABLED — SessionStart will not add language/DB lore; your project/local "
              "knowledge stands alone. Re-enable: `magician-ui lore on`. Takes effect next session start.")
    else:
        cfg["lore"] = "enabled"; save_cfg(cfg)
        print("Magician lore ENABLED (default) — SessionStart adds the detected stack's concise cores "
              "(deep-dives stay on-demand, and repo rules always win). Disable: `magician-ui lore off`.")


def cmd_voice(args):
    """Set magician's output-brevity 'voice' — how wordy responses are, to lower output-token
    cost with no quality loss (output tokens cost several times more than input). Three levels,
    least → most wordy: `warrior` (minimal but complete), `scribe` (the default — leaner than
    usual), `bard` (standard/native verbosity, nothing added). SessionStart adds a brevity
    note for warrior/scribe that cuts filler (preambles, recaps, restating the request) while
    keeping ALL substance and code/commands/errors verbatim — it never compresses prose into
    fragments or jargon. `magician-ui voice <level>` sets it; `voice status` prints the state.
    Resolution (first match wins): env MAGICIAN_VOICE → per-project `.magician/voice` → this
    setting → default scribe. The status bar's `voice` chip shows it live. Takes effect next session."""
    cfg = load_cfg()
    if not args or args[0] in ("status", "--status"):
        lvl = cfg.get("voice", VOICE_DEFAULT)
        shown = "voice" in (cfg.get("components") or ALL)
        print(f"voice level:     {lvl} (default: {VOICE_DEFAULT}; least→most wordy: {' < '.join(VOICE_LEVELS)})")
        print(f"status-bar chip: {'shown' if shown else 'hidden'}  (toggle via `magician-ui set ...,voice`)")
        print("overrides:       env `MAGICIAN_VOICE` · per-project `.magician/voice`")
        return
    lvl = args[0].strip().lower()
    if lvl not in VOICE_LEVELS:
        die(f"unknown voice '{args[0]}'; choose from: {', '.join(VOICE_LEVELS)}")
    cfg["voice"] = lvl
    cfg["updatedAt"] = _now()
    save_cfg(cfg)
    blurb = {
        "warrior": "minimal but complete — the shortest fully-correct answer; no preamble, examples, or recaps.",
        "scribe":  "leaner than usual (default) — necessary explanation only, filler and restatements trimmed.",
        "bard":    "standard/native verbosity — no brevity note added.",
    }[lvl]
    print(f"Voice set to {lvl}: {blurb}")
    print("Substance, code, commands, paths, and errors are always kept verbatim. Takes effect next session start.")


CMDS = {"status": cmd_status, "enable": cmd_enable, "set": cmd_set, "default": cmd_default,
        "disable": cmd_disable, "cleanup": cmd_cleanup, "lore": cmd_lore, "voice": cmd_voice,
        "allow": cmd_allow, "automode": cmd_automode, "reconcile": cmd_reconcile}


def _bad_arg(cmd, args):
    """The first argument `cmd` doesn't take, or None. Checked before a subcommand changes anything."""
    if cmd in ("enable", "set"):
        bad = [a for a in args if a.startswith("-") and a not in ("--all", "--only")
               and not a.startswith("--only=")]
    elif cmd == "disable":
        bad = [a for a in args if a not in ("--purge", "purge", "--force")]
    elif cmd in ("allow", "automode"):
        # Without --off they change nothing, so an old enable form (`allow on`) just gets the pointer.
        bad = [a for a in args if a not in OFF_WORDS] if _wants_off(args) else []
    elif cmd == "lore":
        bad = args[1:] if args and args[0] in LORE_ON + LORE_OFF + ("status", "--status") else args
    elif cmd == "voice":
        bad = args[1:]   # cmd_voice checks the level itself
    else:                # status, default, cleanup, reconcile
        bad = args
    return bad[0] if bad else None


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, args = sys.argv[1], sys.argv[2:]
    fn = CMDS.get(cmd)
    if not fn:
        die(f"unknown command '{cmd}' (try: {', '.join(CMDS)})")
    if any(a in ("-h", "--help") for a in args):
        print(__doc__.strip())
        return
    bad = _bad_arg(cmd, args)
    if bad is not None:
        die(f"`{cmd}` doesn't take '{bad}'; nothing was changed (see `magician-ui --help`).")
    fn(args)


if __name__ == "__main__":
    main()
