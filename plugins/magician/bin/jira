#!/usr/bin/env python3
"""magician jira helper — Jira REST over HTTPS, one command per call.

Connection settings (base URL, token, and the account email for Cloud) are resolved in the
connection-config block below. With an email → Cloud (Basic auth + API v3); without →
Server/Data-Center (Bearer PAT + API v2).

Built for bulk work, so loops over many tickets stay safe:
  * 429/503 → bounded exponential backoff (JIRA_RETRIES), then a clear STOP message —
    so bulk loops don't hammer Jira; do not retry a failed call in a tight loop.
  * GET responses cached briefly (JIRA_CACHE_TTL=30s; cleared on any write) so repeated
    identical queries are free; writes always see fresh data.
  * Bulk loops self-pace (JIRA_MIN_INTERVAL_MS=120) across separate `jira` calls.
  * connect-timeout + JIRA_TIMEOUT so a throttled endpoint can't hang the session.
  * Requests go through curl (system trust store); the auth header is passed on stdin, never
    in the process arguments, and redirects are not followed.
  * List commands take `--max N` (default 50) to cap how many issues come back.
"""
import os, sys, json, re, base64, subprocess, urllib.parse, time, hashlib, shutil

# ---- magician:connection-config begin (Codex build: environment variables only) ----
# Codex build: connection settings come straight from the environment Codex runs in —
# JIRA_BASE_URL, a token (JIRA_API_TOKEN / JIRA_PAT / JIRA_PROD_PAT) and, for Cloud, JIRA_EMAIL.
# Codex has no plugin-settings form, so there is no settings bridge to wait for.
BASE = (os.environ.get("JIRA_BASE_URL") or "").strip().rstrip("/")
TOKEN = ((os.environ.get("JIRA_API_TOKEN") or os.environ.get("JIRA_PAT") or os.environ.get("JIRA_PROD_PAT")) or "").strip()
EMAIL = (os.environ.get("JIRA_EMAIL") or "").strip()
SETUP_HINT = ("export JIRA_BASE_URL and JIRA_API_TOKEN (plus JIRA_EMAIL for Cloud) "
              "in your shell profile or the shell that launches Codex, then restart Codex "
              "from that shell; never paste the token into the conversation")
BASE_URL_HINT = "the Jira base URL (JIRA_BASE_URL)"
# ---- magician:connection-config end ----
V = os.environ.get("JIRA_API_VERSION") or ("3" if EMAIL else "2")

# Resilience knobs (env-overridable) — added after a bulk epic/story/link session hit
# rate limits and the agent hand-rolled urllib loops that re-introduced TLS failures.
TIMEOUT = int(os.environ.get("JIRA_TIMEOUT", "45"))            # per-request seconds
RETRIES = int(os.environ.get("JIRA_RETRIES", "3"))             # on 429/503, with backoff
CACHE_TTL = int(os.environ.get("JIRA_CACHE_TTL", "30"))        # GET cache seconds (0 = off)
MIN_INTERVAL = float(os.environ.get("JIRA_MIN_INTERVAL_MS", "120")) / 1000.0  # bulk-loop pacing floor
# Cache/pacing dir (Codex build): MAGICIAN_HOME, then $CODEX_HOME/magician, then ~/.codex/magician.
PLUGIN_DATA = (os.environ.get("MAGICIAN_HOME") or (os.path.join(os.environ["CODEX_HOME"], "magician") if os.environ.get("CODEX_HOME") else os.path.join(os.path.expanduser("~"), ".codex", "magician")))
CACHE_DIR = os.path.join(PLUGIN_DATA, "jira-cache")
PACE_FILE = os.path.join(PLUGIN_DATA, "jira-last-call")


def die(msg, code=1):
    print(f"jira: {msg}", file=sys.stderr)
    sys.exit(code)


def _take_max(a, default):
    """Split `--max N` / `--max=N` out of a command's arguments → (remaining args, N)."""
    rest, n, i = [], default, 0
    while i < len(a):
        if a[i] == "--max":
            if i + 1 >= len(a):
                die("--max needs a number, e.g. --max 20")
            n, i = a[i + 1], i + 2
            continue
        if a[i].startswith("--max="):
            n, i = a[i][len("--max="):], i + 1
            continue
        rest.append(a[i])
        i += 1
    n = str(n).strip()
    if not n.isdigit() or int(n) < 1:
        die(f"--max needs a positive whole number, got {n!r}")
    return rest, int(n)


def _auth():
    if EMAIL:
        return "Basic " + base64.b64encode(f"{EMAIL}:{TOKEN}".encode()).decode()
    return "Bearer " + TOKEN


def _ckey(method, path):
    return hashlib.sha1(f"{method} {BASE}/{path}".encode()).hexdigest()[:20]


def _cache_get(method, path):
    if CACHE_TTL <= 0 or method != "GET":
        return None
    p = os.path.join(CACHE_DIR, _ckey(method, path) + ".json")
    try:
        if time.time() - os.path.getmtime(p) <= CACHE_TTL:
            return json.load(open(p))
    except Exception:
        pass
    return None


def _cache_put(method, path, val):
    if CACHE_TTL <= 0 or method != "GET":
        return
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        json.dump(val, open(os.path.join(CACHE_DIR, _ckey(method, path) + ".json"), "w"))
    except Exception:
        pass


def _pace():
    # Enforce a minimum gap between calls (across separate `jira` processes, via a
    # marker file's mtime) so bulk loops don't hammer Jira into rate-limiting.
    if MIN_INTERVAL > 0:
        try:
            wait = MIN_INTERVAL - (time.time() - os.path.getmtime(PACE_FILE))
            if wait > 0:
                time.sleep(min(wait, 5))
        except Exception:
            pass
    try:
        os.makedirs(PLUGIN_DATA, exist_ok=True)
        open(PACE_FILE, "w").write(".")
    except Exception:
        pass


def api(method, path, body=None, timeout=None):
    if not BASE or not TOKEN:
        die(f"no Jira {'base URL' if not BASE else 'API token'} configured: {SETUP_HINT}.")
    if not BASE.lower().startswith("https://") and \
            urllib.parse.urlsplit(BASE).hostname not in ("localhost", "127.0.0.1", "::1"):
        die(f"{BASE_URL_HINT} must start with https:// so the token isn't sent in clear text.")
    method = method.upper()
    timeout = timeout or TIMEOUT
    if method == "GET":
        cached = _cache_get(method, path)
        if cached is not None:
            return cached
    else:
        shutil.rmtree(CACHE_DIR, ignore_errors=True)  # a write invalidates cached reads
    # curl makes the request so the system trust store is used (the standard library HTTP client
    # may not see the same roots). The auth header goes on stdin (-H @-) so it never shows in the
    # process list. The reply is only parsed as JSON (a GET reply is also cached briefly) or quoted
    # in an error message.
    headers = "Authorization: " + _auth() + "\nAccept: application/json\n"
    cmd = ["curl", "--silent", "--show-error", "--compressed", "--connect-timeout", "10",
           "--max-time", str(timeout), "-X", method, "-H", "@-"]
    if body is not None:
        headers += "Content-Type: application/json\n"
        cmd += ["--data-binary", json.dumps(body)]
    cmd += ["-w", "\n%{http_code}", f"{BASE}/{path}"]
    attempt = 0
    while True:
        _pace()
        try:
            p = subprocess.run(cmd, input=headers, capture_output=True, text=True, timeout=timeout + 5)
        except subprocess.TimeoutExpired:
            die(f"request timed out after {timeout}s — check VPN / base URL (raise JIRA_TIMEOUT if needed).")
        if p.returncode != 0:
            die(f"connection failed — {p.stderr.strip()[:200]} (check {BASE_URL_HINT} and VPN).")
        out = p.stdout
        nl = out.rfind("\n")
        code, payload = out[nl + 1:].strip(), out[:nl]
        if not code.isdigit():
            die(f"unexpected response: {out[:200]}")
        code = int(code)
        if code in (429, 503) and attempt < RETRIES:
            time.sleep(min(2 ** attempt, 30))   # exponential backoff, capped
            attempt += 1
            continue
        if code == 429:
            die("HTTP 429 — Jira is rate-limiting and retries are exhausted. STOP: do not retry in a tight "
                "loop. Wait ~60s, shrink the batch, and pace requests (JIRA_MIN_INTERVAL_MS=300+). "
                f"Body: {payload[:160]}")
        if 300 <= code < 400:
            die(f"HTTP {code} redirect on {method} {path} — redirects aren't followed; check {BASE_URL_HINT}.")
        if code >= 400:
            die(f"HTTP {code} on {method} {path} — {payload[:400]}")
        val = json.loads(payload) if payload.strip() else {}
        _cache_put(method, path, val)
        return val


def _name(o):
    return (o or {}).get("name") or (o or {}).get("displayName") or ""


# Block-level ADF nodes whose text should end with a newline so structure survives.
_ADF_BLOCKS = {"paragraph", "heading", "blockquote", "codeBlock", "panel",
               "tableRow", "mediaSingle", "bulletList", "orderedList"}


def _adf(node):
    """Flatten an Atlassian Document Format node (Jira Cloud rich text) to readable text."""
    if node is None:
        return ""
    if isinstance(node, str):
        return node
    if isinstance(node, list):
        return "".join(_adf(n) for n in node)
    if not isinstance(node, dict):
        return str(node)
    t = node.get("type")
    if t == "text":
        return node.get("text", "")
    if t == "hardBreak":
        return "\n"
    if t == "rule":
        return "\n---\n"
    attrs = node.get("attrs") or {}
    if t == "mention":
        return "@" + str(attrs.get("text") or attrs.get("displayName") or "").lstrip("@")
    if t == "emoji":
        return attrs.get("text") or attrs.get("shortName") or ""
    if t == "inlineCard":
        return attrs.get("url", "")
    inner = _adf(node.get("content"))
    if t == "listItem":
        return "- " + inner.strip() + "\n"
    if t in _ADF_BLOCKS:
        return inner.rstrip() + "\n"
    return inner


def _rich(v, limit=0):
    """Jira rich field (description / comment body) → readable text.

    Handles ADF documents (Cloud, API v3 → dict/list) and wiki-markup strings
    (Server/DC, API v2). limit=0 (default) means the WHOLE field — no silent cut.
    """
    s = _adf(v) if isinstance(v, (dict, list)) else (v or "")
    s = re.sub(r"[ \t]+", " ", s)
    s = re.sub(r"\n{3,}", "\n\n", s).strip()
    if limit and len(s) > limit:
        return s[:limit] + f"\n… [truncated at {limit} chars — raise the cap or use `jira raw`]"
    return s


def c_myself(a):
    d = api("GET", f"rest/api/{V}/myself")
    print(f'{d.get("displayName")} <{d.get("emailAddress","")}>')


def c_get(a):
    if not a:
        die("usage: jira get <KEY>")
    d = api("GET", f"rest/api/{V}/issue/{a[0]}"
            "?fields=summary,status,issuetype,assignee,reporter,priority,resolution,updated,parent,description")
    f = d.get("fields", {})
    print(f'{d.get("key")} — {f.get("summary","")}')
    print(f'  status: {_name(f.get("status"))} | resolution: {_name(f.get("resolution")) or "Unresolved"}')
    print(f'  type: {_name(f.get("issuetype"))} | priority: {_name(f.get("priority"))} '
          f'| assignee: {_name(f.get("assignee")) or "Unassigned"} | reporter: {_name(f.get("reporter"))}')
    print(f'  updated: {(f.get("updated") or "")[:16].replace("T"," ")}')
    p = f.get("parent")
    if p:
        print(f'  parent: {p.get("key")} - {(p.get("fields") or {}).get("summary","")}')
    print(f'  {BASE}/browse/{d.get("key")}')
    # The description IS the ticket — print it in full (ADF or wiki). JIRA_DESC_MAX>0 caps it.
    desc = _rich(f.get("description"), int(os.environ.get("JIRA_DESC_MAX", "0") or "0"))
    if desc:
        print("\ndescription:")
        print(desc)


def c_search(a):
    a, limit = _take_max(a, os.environ.get("JIRA_MAX", "50"))
    if not a:
        die("usage: jira search <JQL> [--max N]")
    q = urllib.parse.urlencode({"jql": " ".join(a),
                                "maxResults": limit,
                                "fields": "summary,status,assignee,issuetype"})
    d = api("GET", f"rest/api/{V}/search?{q}")
    print(f'total: {d.get("total")}')
    for i in d.get("issues", []):
        f = i["fields"]
        print(f'  {i["key"]:<12} [{_name(f.get("status"))}] '
              f'{_name(f.get("assignee")) or "-"} · {f.get("summary","")[:70]}')


def c_transitions(a):
    if not a:
        die("usage: jira transitions <KEY>")
    d = api("GET", f"rest/api/{V}/issue/{a[0]}/transitions")
    for t in d.get("transitions", []):
        print(f'  {t["id"]} → {t["name"]}')


def c_raw(a):
    if len(a) < 2:
        die("usage: jira raw <METHOD> <rest/path> [json-body]")
    body = json.loads(a[2]) if len(a) > 2 and a[2] else None
    out = json.dumps(api(a[0].upper(), a[1], body), indent=2)
    # No silent truncation — a raw fetch returns the whole resource. Set JIRA_RAW_MAX=<N> only if you
    # deliberately want to cap output; unset/0 means full output.
    cap = int(os.environ.get("JIRA_RAW_MAX", "0") or "0")
    print(out[:cap] if cap > 0 else out)


def c_url(a):
    if not a:
        die("usage: jira url <KEY>")
    print(f"{BASE}/browse/{a[0]}")


def c_mine(a):
    # my open work — one predefined query, no JQL to compose
    c_search(["assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC"] + a)


def c_board(a):
    if not a:
        die("usage: jira board <name>")
    d = api("GET", "rest/agile/1.0/board?name=" + urllib.parse.quote(" ".join(a)))
    for b in d.get("values", []):
        loc = (b.get("location") or {}).get("projectKey", "")
        print(f'  {b.get("id")}  {b.get("type","")}  {b.get("name","")}{" ["+loc+"]" if loc else ""}')


def c_sprint(a):
    # active sprint of a board + MY not-done issues in it — both REST calls in ONE invocation
    a, limit = _take_max(a, os.environ.get("JIRA_MAX", "50"))
    board = a[0] if a else os.environ.get("JIRA_BOARD", "")
    if not board:
        die("usage: jira sprint <boardId> [--max N]  (find it: jira board <name>; or set JIRA_BOARD)")
    vals = api("GET", f"rest/agile/1.0/board/{board}/sprint?state=active").get("values", [])
    if not vals:
        die(f"no active sprint on board {board}")
    sp = vals[0]
    print(f'active sprint: {sp.get("id")} — {sp.get("name")}')
    q = urllib.parse.urlencode({
        "jql": f'sprint = {sp.get("id")} AND assignee = currentUser() AND statusCategory != Done ORDER BY status ASC',
        "maxResults": limit,
        "fields": "summary,status,issuetype"})
    d = api("GET", f"rest/api/{V}/search?{q}")
    print(f'my pending: {d.get("total")}')
    for i in d.get("issues", []):
        f = i["fields"]
        print(f'  {i["key"]:<12} [{_name(f.get("status"))}] {_name(f.get("issuetype"))} · {f.get("summary","")[:66]}')


def c_comments(a):
    # All comments, full bodies (ADF or wiki), paginated — the dedicated /comment endpoint
    # returns the whole thread; the old ?fields=comment path could omit older comments and
    # capped each body to 140 chars / the last 10 comments. JIRA_COMMENT_MAX>0 caps each body.
    if not a:
        die("usage: jira comments <KEY>")
    cap = int(os.environ.get("JIRA_COMMENT_MAX", "0") or "0")
    got, start = [], 0
    while True:
        page = api("GET", f"rest/api/{V}/issue/{a[0]}/comment?startAt={start}&maxResults=100")
        batch = page.get("comments", [])
        got.extend(batch)
        start += len(batch)
        total = page.get("total", len(got))
        if not batch or start >= total:
            break
    print(f"comments: {len(got)}")
    for c in got:
        au = (c.get("author") or {}).get("displayName", "")
        when = (c.get("created") or "")[:16].replace("T", " ")
        print(f'\n[{when}] {au}:')
        print(_rich(c.get("body"), cap))


def c_create(a):
    # jira create '<fields-json>'  → one create via the CLI (throttle-aware), prints the new key.
    # Accepts either a full {"fields":{...}} body or a bare {...} treated as fields.
    if not a:
        die('usage: jira create \'{"fields":{"project":{"key":"PROJ"},"summary":"...","issuetype":{"name":"Story"}}}\'')
    try:
        body = json.loads(a[0])
    except Exception as e:
        die(f"invalid JSON: {e}")
    if "fields" not in body:
        body = {"fields": body}
    d = api("POST", f"rest/api/{V}/issue", body)
    print(f'created {d.get("key")} — {BASE}/browse/{d.get("key")}')


def c_link(a):
    # jira link <inwardKey> "<Link Type>" <outwardKey>  → create one issue link (throttle-aware).
    # Loop this for bulk dependencies; the CLI paces + backs off so it won't hammer Jira.
    if len(a) < 3:
        die('usage: jira link <inwardKey> "<Link Type, e.g. Blocks/Depends>" <outwardKey>')
    inward, ltype, outward = a[0], a[1], a[2]
    api("POST", f"rest/api/{V}/issueLink",
        {"type": {"name": ltype}, "inwardIssue": {"key": inward}, "outwardIssue": {"key": outward}})
    print(f'linked {inward} —{ltype}→ {outward}')


CMDS = {"myself": c_myself, "get": c_get, "search": c_search, "jql": c_search,
        "transitions": c_transitions, "raw": c_raw, "url": c_url,
        "mine": c_mine, "board": c_board, "sprint": c_sprint, "comments": c_comments,
        "create": c_create, "link": c_link}


def main():
    av = sys.argv[1:]
    if not av or av[0] in ("help", "-h", "--help"):
        print(__doc__)
        print("commands: myself | mine [--max N] | sprint <boardId> [--max N] | get <KEY> | comments <KEY> | "
              "search <JQL> [--max N] | transitions <KEY> | board <name> | url <KEY> | "
              "create '<fields-json>' | link <inwardKey> \"<Type>\" <outwardKey> | "
              "raw <METHOD> <rest/path> [json-body]", file=sys.stderr)
        return
    fn = CMDS.get(av[0])
    if not fn:
        die(f"unknown command '{av[0]}' (try: jira help)")
    fn(av[1:])


if __name__ == "__main__":
    main()
