# Workspace local — per-machine, never committed
.workspace/local/

# OS
.DS_Store
Thumbs.db
desktop.ini
__MACOSX/

# Local scratch, drafts and tool state; the repo root is the shipped plugin folder.
# Drafts are ignored in any folder, tool state at the root.
/.workspace/
/.claude/
/.codex/
X-*.md
MEDIUM-*.md
PRESENTATION*.md
TRANSMUTE-*.md
gemini_generated.png

# Editor
.vscode/settings.json
.idea/

# Test artifacts
/tmp/magician-test/

# Behavioral eval run output (claude plugin eval, run by scripts/gate.sh --evals)
/.gate-evals*.json
/.gate-evals*.log
# The token-budget baseline is tracked: scripts/gate.sh compares each run against it
evals/results/*
!evals/results/budget.json
# The per-case eval baseline is tracked too: scripts/gate.sh --evals fails on a pass-to-fail flip against it
!evals/results/last.json

__pycache__/
*.pyc

# The Codex package is generated and committed on the `codex-plugin` branch only
/plugins/

# Codex package built by scripts/build-codex.sh (default output dist/codex/)
/dist/
