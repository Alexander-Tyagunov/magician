TERMS_FILE = os.path.join(".magician", "ste-terms")

# ---------------------------------------------------------------- word list (W4) --------------
# magician's own avoid -> use list, paraphrased from knowledge/aste100.md section 4. Keys are
# lowercase; a key with spaces is a phrase. A verb key matches its usual inflections. Words that
# are also software technical verbs (execute, validate, implement, enable, allow, provide,
# component, verify) are left out on purpose: the exemption for technical nouns and verbs applies.
AVOID = {
    "prior to": "before", "previous to": "before", "subsequent to": "after",
    "in order to": "to", "utilize": "use", "utilise": "use", "sufficient": "enough",
    "adequate": "enough", "adjacent": "next to", "commence": "start", "initiate": "start",
    "terminate": "stop", "conclude": "end", "carry out": "do", "accomplish": "do",
    "achieve": "complete", "additional": "more", "assist": "help", "attempt": "try",
    "ensure": "make sure", "guarantee": "make sure", "indicate": "show", "modify": "change",
    "alter": "change", "obtain": "get", "acquire": "get", "necessitate": "need",
    "permit": "let", "locate": "find", "retain": "keep", "in the event that": "if",
    "regarding": "about", "concerning": "about", "with respect to": "about",
    "by means of": "with", "therefore": "so", "consequently": "so", "hence": "so",
    "nevertheless": "but", "numerous": "many", "various": "several", "demonstrate": "show",
    "furnish": "give", "optimal": "best", "facilitate": "help", "functionality": "function",
    "frequently": "often", "immediately": "now",
}
# Verbs on the list: the regex also matches -s, -es, -ed, -d, -ing forms (utilizes, modified).
VERBS = {"utilize", "utilise", "commence", "initiate", "terminate", "conclude", "accomplish",
         "achieve", "assist", "attempt", "ensure", "guarantee", "indicate", "modify", "alter",
         "obtain", "acquire", "necessitate", "permit", "locate", "retain", "demonstrate",
         "furnish", "facilitate"}


def _verb_pattern(base: str) -> str:
    if base.endswith("y"):
        return r"(?:%s|%s(?:ies|ied|ying))" % (re.escape(base), re.escape(base[:-1]))
    stem = base[:-1] if base.endswith("e") else base
    return r"(?:%s|%s(?:s|es|ed|d|ing))" % (re.escape(base), re.escape(stem))


AVOID_RE = re.compile(
    r"\b(?:" + "|".join(
        _verb_pattern(k) if k in VERBS else re.escape(k).replace(r"\ ", r"\s+")
        for k in sorted(AVOID, key=len, reverse=True)) + r")\b", re.I)


def _avoid_key(text: str) -> str:
    low = re.sub(r"\s+", " ", text.lower())
    if low in AVOID:
        return low
    for base in VERBS:
        if re.fullmatch(_verb_pattern(base), low):
            return base
    return low


