function chart(key){const c=document.querySelector('#charts .chart[data-chart="'+key.replace(/"/g,'')+'"]'); if(!c) return null; const el=c.cloneNode(true); const id=cur>0?items[cur].id:null; const svg=el.querySelector('svg'); const t=el.querySelector('title'); if(svg&&t){svg.setAttribute('aria-label',t.textContent); svg.removeAttribute('aria-labelledby')} el.querySelectorAll('[id]').forEach(x=>x.removeAttribute('id')); el.querySelectorAll('[data-step]').forEach(x=>{x.classList.toggle('cur',x.dataset.step===id); x.classList.toggle('deferred',!!byId[x.dataset.step]&&byId[x.dataset.step].review.status==='deferred')}); return el.outerHTML}
function block(title,inner){return inner?'<div class="block">'+(title?'<h3>'+esc(title)+'</h3>':'')+inner+'</div>':''}
