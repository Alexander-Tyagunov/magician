<script>
(function(){
'use strict';
const PLAN=JSON.parse(document.getElementById('plan').textContent);
const PLAN_MD=JSON.parse(document.getElementById('plan-md-raw').textContent);
const $=s=>document.querySelector(s);
const root=document.documentElement;
/* Transport (data-review): auto | local | artifact | static.
   local    — the companion server injected window.__MAGICIAN_LIVE: events are POSTed, state is polled / streamed.
   artifact — the page runs as a Claude Artifact: events go to the artifact's db capability, state is a db document.
   static   — nothing leaves the page; every send composes a chat line.
   auto     — local when __MAGICIAN_LIVE is present, else artifact when window.claude.use exists, else static. */
const MODE=root.dataset.review||'auto';
const LIVE=((MODE==='auto'||MODE==='local')&&window.__MAGICIAN_LIVE&&typeof window.__MAGICIAN_LIVE==='object')?window.__MAGICIAN_LIVE:null;
const ARTIFACT_HOST=!LIVE&&(MODE==='auto'||MODE==='artifact')&&!!(window.claude&&typeof window.claude.use==='function');
const RENDERED_VERSION=Number(PLAN.version)||1;
PLAN.version=RENDERED_VERSION;
const steps=PLAN.steps||[]; const byId={};
function normStep(s){s.review=Object.assign({status:'pending',note:'',edited_text:''},s.review||{}); if(!('v' in s)) s.v=PLAN.version; s.history=Array.isArray(s.history)?s.history:[]; s.depends_on=s.depends_on||[]; s.touches=s.touches||[]; s.files=s.files||{}; s.red=s.red||{}; s.green=s.green||{}; s.verify=s.verify||[]; s.risk=s.risk||{}; s.effort=s.effort||{}; return s}
steps.forEach(normStep); steps.forEach(s=>{byId[s.id]=s});
const ctx=PLAN.context||{}; const comps=[]; const edges=[]; const layers=[];
function deriveContext(){comps.length=0; edges.length=0; layers.length=0; (ctx.components||[]).filter(c=>c&&c.id).forEach(c=>comps.push(c)); (ctx.edges||[]).map(e=>Array.isArray(e)?e:[e.from,e.to]).filter(e=>e[0]&&e[1]).forEach(e=>edges.push(e)); comps.forEach(c=>{if(!layers.includes(c.layer)) layers.push(c.layer)}); steps.forEach(s=>{if(s.layer&&!layers.includes(s.layer)) layers.push(s.layer)})}
deriveContext();
const tint=l=>'var(--l-'+((Math.max(0,layers.indexOf(l))%6)+1)+')';
const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
let cur=0, playing=false, speed=1, timer=null, dwellStart=0, dwellLen=0, raf=null;
const items=[{kind:'context',id:'context'}].concat(steps);
let n=items.length;
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}
function num(x){return typeof x==='number'&&isFinite(x)?x:0}
function minutes(){return steps.filter(s=>s.review.status!=='deferred').reduce((a,s)=>a+num(s.effort.minutes),0)}

/* ---------- link state (shared by every transport) ---------- */
const link={kind:ARTIFACT_HOST?'pending':(LIVE?'local':'static'),db:null,readOnly:false,stateVersion:0,etag:null,queue:Promise.resolve(),pending:[],lastHint:'',lastNotice:'',seen:{},cached:false,unsub:[]};
const isLive=()=>link.kind!=='static';
const REVISING_TYPES=['step.change_request','step.edit','plan.change_request'];
const WAIT_MS=600000; /* 10 min without a revision ⇒ "waiting for Claude" */
let revising=null;   /* {step, started, confirmed, waiting} while a revision is in flight */
function liveUrl(p){const b=String(LIVE&&LIVE.base||''); return b?b.replace(/\/+$/,'')+'/'+p:p}
function statusLine(){return link.kind==='local'?'Live · same session · events.jsonl':link.kind==='artifact'?'Artifact · database · events collection':link.kind==='pending'?'Artifact · connecting to the database…':'Static — this page cannot reach the session; reply in chat (e.g. “T7: use managed Redis”)'}

/* ---------- header ---------- */
function renderHeader(){
  $('#ver').textContent='v'+PLAN.version;
  const par=steps.filter(s=>s.parallel).length;
  $('#counts').textContent=steps.length+' steps · '+(PLAN.waves||[]).length+' waves · '+par+' parallel · ~'+(Math.round(minutes()/60*10)/10)+' h';
  const settled=steps.every(s=>['approved','deferred','edited'].includes(s.review.status));
  $('#approveplan').disabled=!(PLAN.status==='in_review'||PLAN.status==='draft')||link.readOnly; $('#approveplan').title=settled?'Every step is reviewed':'Some steps are not reviewed yet — you will be asked to confirm';
  $('#reject').disabled=link.readOnly||PLAN.status==='approved'||PLAN.status==='rejected';
  const ps=$('#planstatus'); ps.textContent=String(PLAN.status||'').replace('_',' ');
  const tally={}; steps.forEach(s=>{tally[s.review.status]=(tally[s.review.status]||0)+1});
  $('#tally').textContent=['approved','edited','deferred','changed','revising','pending'].filter(k=>tally[k]).map(k=>tally[k]+' '+k).join(' · ')||'no steps';
  ps.className='chip '+(PLAN.status==='approved'?'ok':PLAN.status==='rejected'?'stop':'');
  $('#sources').textContent=(PLAN.sources||[]).map(s=>s.id+' '+s.label).join(' · ')||'—';
  $('#modenote').textContent=(isLive()?statusLine():'Static page — review marks stay in this tab; reply in chat to change the plan')+(link.readOnly?' · read-only':'')+' · Version history: '+Array.from({length:PLAN.version},(_,k)=>'v'+(k+1)).join(', ');
  $('#helperstatus').textContent=statusLine(); $('#helperlink').classList.toggle('live',link.kind==='local'||link.kind==='artifact');
  $('#helpersend').disabled=link.readOnly; $('#helpersend').textContent=isLive()?'Send':'Copy chat line';
}

/* ---------- timeline ---------- */
function renderTimeline(){
  const tl=$('#timeline'); tl.innerHTML='';
  const groups=[{id:'ctx',title:'Context',count:1,idx:[0]}].concat((PLAN.waves||[]).map(w=>({id:w.id,title:w.title||'',count:(w.steps||[]).length,idx:(w.steps||[]).map(id=>items.findIndex(i=>i.id===id)).filter(i=>i>0)})));
  groups.forEach(g=>{
    const b=document.createElement('button'); b.className='tl'; b.setAttribute('role','tab'); b.type='button';
    b.innerHTML='<span class="t">'+(g.id==='ctx'?'':esc(g.id)+' · ')+esc(g.title)+'</span><span class="c">'+(g.id==='ctx'?'step 0':g.count+' steps')+'</span><span class="bar"></span>';
    const on=g.idx.includes(cur); b.setAttribute('aria-selected',on); if(on) b.setAttribute('aria-current','step');
    b.onclick=()=>{if(g.idx.length) go(g.idx[0])}; tl.appendChild(b);
  });
}

/* ---------- map ---------- */
const pos={};
function buildMap(){
  if(!comps.length){$('#map').innerHTML='<p class="dim">No components declared in context.components — nothing to map.</p>';return}
  const W=1200,bandH=86,pad=16; const H=layers.length*bandH+pad;
  let svg='<svg viewBox="0 0 '+W+' '+H+'" role="img" aria-labelledby="maptitle mapdesc"><title id="maptitle">Architecture map</title><desc id="mapdesc">'+esc(layers.map(l=>l+': '+comps.filter(c=>c.layer===l).map(c=>c.label).join(', ')).join('. '))+'</desc>';
  layers.forEach((l,i)=>{
    const y=i*bandH+8; svg+='<rect class="band" fill="'+tint(l)+'" x="0" y="'+y+'" width="'+W+'" height="'+(bandH-6)+'" rx="8"/><text class="bandlabel" x="14" y="'+(y+18)+'">'+esc(l)+'</text>';
    const cs=comps.filter(c=>c.layer===l); const gap=(W-120)/Math.max(1,cs.length);
    cs.forEach((c,j)=>{const x=110+j*gap+gap/2-80, cy=y+30; pos[c.id]={x:x+80,y:cy+22,l:x,r:x+160,t:cy,b:cy+44};});
  });
  svg+='<g id="edges">'+edges.map(([a,b])=>{const A=pos[a],B=pos[b]; if(!A||!B)return ''; const sy=A.y>B.y?A.t:A.b, ty=A.y>B.y?B.b:B.t; const mid=(sy+ty)/2; return '<path class="edge" data-e="'+esc(a)+'|'+esc(b)+'" d="M'+A.x+','+sy+' C'+A.x+','+mid+' '+B.x+','+mid+' '+B.x+','+ty+'"/>'}).join('')+'</g>';
  svg+='<g id="nodes" role="group" aria-label="Components">'+comps.map(c=>{const p=pos[c.id]; const sub=c.sub||c.layer; return '<g class="node '+(c.exists===false?'new':'')+'" data-id="'+esc(c.id)+'" tabindex="0" role="button" aria-label="'+esc(c.label)+', '+esc(sub)+(c.exists===false?', new':'')+'"><rect x="'+p.l+'" y="'+p.t+'" width="160" height="44" rx="8"/><text x="'+(p.l+12)+'" y="'+(p.t+19)+'">'+esc(String(c.label||c.id).slice(0,24))+'</text><text class="sub" x="'+(p.l+12)+'" y="'+(p.t+34)+'">'+esc(String(sub).slice(0,30))+'</text>'+(c.exists===false?'<rect class="badgebg" x="'+(p.r-36)+'" y="'+(p.t-8)+'" width="30" height="16" rx="8"/><text class="badge" x="'+(p.r-29)+'" y="'+(p.t+4)+'">NEW</text>':'')+'</g>'}).join('')+'</g>';
  svg+='<circle class="packet" r="5"/></svg>';
  $('#map').innerHTML=svg;
  $('#map').querySelectorAll('.node').forEach(nd=>{const open=()=>{const id=nd.dataset.id; const i=items.findIndex((it,k)=>k>0&&it.touches.includes(id)); if(i>0) go(i)}; nd.onclick=open; nd.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open()}}});
}
function updateMap(){
