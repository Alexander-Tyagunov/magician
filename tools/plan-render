#!/usr/bin/env python3
"""magician plan-render — one plan.json in, plan.md + plan.html out (no deps, no network).

/blueprint writes plan.json (schema magician.plan/1) once; this tool validates it and renders the two
documents every consumer reads, so a revision can never leave them out of sync:
  plan.md    the task list /orchestrate and /ward execute (the Task Format of skills/blueprint),
             with a `<!-- magician.plan/1 v<n> sha256:<canonical json> -->` trailer;
  plan.html  a self-contained walkthrough a person reviews from file:// — player, wave timeline,
             SVG architecture map, step detail, inline SVG infographics, per-step review toolbar and
             the "plan document" dialog (plan.md pre-rendered to HTML here, the wave graph as SVG).

Subcommands (one clean command per call, so one `Bash(plan-render *)` allow rule covers all):
  plan-render check <plan.json>                      validate; exit 2 with one line per violation
  plan-render md    <plan.json> [-o plan.md]         render plan.md (stdout without -o)
  plan-render html  <plan.json> [-o plan.html] [--theme light|dark|auto] [--transport auto|local|artifact|static]
                                                     [--static] [--mermaid]
  plan-render workflow <plan.json> [-o plan.workflow.js]   a Claude Code Workflow script: one phase per
                                                     wave, parallel() for the parallel steps, agent() per
                                                     task with the bounded return schema (deferred omitted)
  plan-render diff  <a.json> <b.json>                JSON summary: changed fields per step id,
                                                     added / removed steps, changed plan fields
  plan-render all   <plan.json>                      check, then plan.md + plan.html + plan.workflow.js
                                                     next to the json and history/plan.v<version>.json

Output is deterministic: the same JSON gives byte-identical plan.md, plan.html and plan.workflow.js
(no timestamps). The page carries a Content-Security-Policy that forbids every remote load; nothing
is fetched. `--transport` picks how the page's review toolbar reaches the session: `local` (the
companion server injects window.__MAGICIAN_LIVE; events are POSTed, state polled and streamed),
`artifact` (the page runs as a Claude Artifact and uses its `db` capability), `static` (every send
composes a chat line) or `auto` (default: local when injected, else artifact when the host offers
`claude.use`, else static). `--static` is `--transport static`.
`--mermaid` draws the wave graph with `mmdc` when it is on PATH (opt-in; output then depends on it).
"""
from __future__ import annotations

import argparse
import hashlib
import html
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

SCHEMA = "magician.plan/1"
MAX_BYTES = 256 * 1024
MAX_VERSION = 10000
PLAN_STATUS = ("draft", "in_review", "approved", "rejected")
REVIEW_STATUS = ("pending", "approved", "deferred", "edited", "changed")
KINDS = ("context", "decision", "change", "verify", "rollout")
RISK_LEVELS = ("low", "medium", "high")
LAYER_PALETTE = 6  # --l-1 … --l-6 cycle over the layers in order of first appearance
STEP_ID = re.compile(r"^T[1-9]\d*$")
PLAIN_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")
RESERVED_IDS = ("__proto__", "constructor", "prototype")
# Fields that may hold line breaks (rendered as paragraphs, fences or blockquotes); every other string
# is a single line. No string may hold another control character.
MULTILINE = ("intent", "diff_sketch", "red.code", "green.sketch", "review.edited_text", "context.summary")
CONTROL = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")

# Credential shapes the plan text must never carry (the page and plan.md are committed). The raw
# JSON text is scanned (key-aware: a secret-looking key with a long value) and so is every decoded
# string (JSON escaping hides quotes from the raw scan).
LEAK_PATTERNS = (
    ("AWS access key", re.compile(r"AKIA[0-9A-Z]{16}")),
    ("private key", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY")),
    ("hardcoded credential",
     re.compile(r"""(?i)(api[_-]?key|secret|password|passwd|token)\s*[:=]\s*['"][^'"]{8,}""")),
    ("GitHub token", re.compile(r"\bgh[posru]_[A-Za-z0-9]{36,}")),
    ("API key", re.compile(r"\bsk-[A-Za-z0-9_-]{20,}")),
    ("Slack token", re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}")),
    ("JWT", re.compile(r"\beyJ[A-Za-z0-9_-]{20,}\.eyJ")),
    ("bearer token", re.compile(r"\bBearer\s+[A-Za-z0-9._-]{20,}")),
)
RAW_KEY_LEAK = re.compile(r'(?i)"(api[_-]?key|secret|password|passwd|token)"\s*:\s*"[^"]{8,}"')
HOME_PATH = re.compile(r"(^|[\s\"'=:])(/Users/|/home/)")
BAD_PATH = re.compile(r"(^|/)\.\.(/|$)|^~|^/|^[A-Za-z]:[\\/]|^\\\\|\\")
# Command shapes that must never sit in red.run, green.run or verify (they are run by /orchestrate).
DESTRUCTIVE = re.compile(
    r"(?i)(\brm\s+(-[a-z]*[rf][a-z]*\s+|--recursive\s+|--force\s+)+|\bgit\s+(push\s+.*(--force|\s\+\S|-f\b)"
    r"|reset\s+--hard|clean\s+-[a-z]*f|branch\s+-D\b|checkout\s+\.\s*$)|\bdrop\s+(table|database|schema)\b"
    r"|\btruncate\s+table\b|\bmkfs\b|\bdd\s+if=|>\s*/dev/sd|\bchmod\s+-R\s+777\s+/|:\(\)\s*\{|\bshred\b"
    r"|\bformat\s+[a-z]:|\bfind\b.*\s-delete\b|\b(curl|wget)\b.*\|\s*(sudo\s+)?(ba|z|k|da)?sh\b"
    r"|\bterraform\s+destroy\b|\bkubectl\s+delete\b)")
MAX_DIFF_LINES = 40
MAX_INFOGRAPHIC_ROWS = 6


def die(msg: str, code: int = 1) -> None:
    print(f"plan-render: {msg}", file=sys.stderr)
    sys.exit(code)


# ───────────────────────────── loading / canonical form ─────────────────────────────
def _no_constant(name: str):
    raise ValueError(f"{name} is not valid JSON")


def _no_duplicate_keys(pairs):
    out = {}
    for k, v in pairs:
        if k in out:
            raise ValueError(f"duplicate key {k!r}")
        out[k] = v
    return out


def parse_plan(raw: bytes) -> dict:
    """Strict JSON: no NaN/Infinity, no duplicate keys (both would pass json.loads silently)."""
    return json.loads(raw.decode("utf-8"), parse_constant=_no_constant, object_pairs_hook=_no_duplicate_keys)


def load(path: str) -> tuple[dict, bytes]:
    try:
        with open(path, "rb") as fh:
            raw = fh.read()
    except OSError as e:
        die(f"cannot read {path}: {e.strerror}")
    try:
        plan = parse_plan(raw)
    except (UnicodeDecodeError, ValueError, RecursionError) as e:
        die(f"{path}: not valid JSON ({e})", 2)
    return plan, raw


def canonical(plan: dict) -> bytes:
    return json.dumps(plan, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def plan_hash(plan: dict) -> str:
    return hashlib.sha256(canonical(plan)).hexdigest()


def fmt_num(x) -> str:
    if isinstance(x, bool):
        return str(x)
    if isinstance(x, int):
        return str(x)
    if isinstance(x, float):
        return ("%.2f" % x).rstrip("0").rstrip(".")
    return str(x)


# ───────────────────────────────── validation ───────────────────────────────────
def _is_str_list(v) -> bool:
    return isinstance(v, list) and all(isinstance(x, str) for x in v)


def _is_int(v, lo: int = 0, hi: int | None = None) -> bool:
    return isinstance(v, int) and not isinstance(v, bool) and v >= lo and (hi is None or v <= hi)


def _strings(obj, path: str = "$"):
    if isinstance(obj, str):
        yield path, obj
    elif isinstance(obj, dict):
        for k, v in obj.items():
            yield from _strings(v, f"{path}.{k}")
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            yield from _strings(v, f"{path}[{i}]")


def _edge(e) -> tuple:
    if isinstance(e, dict):
        return e.get("from"), e.get("to")
    if isinstance(e, (list, tuple)) and len(e) == 2:
        return e[0], e[1]
    return None, None


def norm_path(p: str) -> str:
    while p.startswith("./"):
        p = p[2:]
    return p


def _check_text(plan, out: list[str]) -> None:
    """Control characters never; line breaks only in the multi-line fields; no line in a multi-line
    field may start like a heading, a fence or a task line (it would forge plan.md structure)."""
    for path, value in _strings(plan):
        if CONTROL.search(value):
            out.append(f"text: {path} holds a control character")
            continue
        field = re.sub(r"\[\d+\]", "", path)
        field = re.sub(r"^\$\.(steps\.)?", "", field)
        if "\n" in value or "\r" in value:
            if field not in MULTILINE:
                out.append(f"text: {path} must be a single line (line breaks are allowed only in "
                           f"{', '.join(MULTILINE)})")
                continue
            for line in value.splitlines():
                st = line.lstrip()
                if st.startswith("#") or st.startswith("```") or st.startswith("- [ ]") or st.startswith("- [x]"):
                    out.append(f"text: {path} has a line starting with {st[:3]!r}, which would forge plan.md structure")
                    break
        elif field == "diff_sketch" or field == "red.code" or field == "green.sketch":
            if value.lstrip().startswith("```"):
                out.append(f"text: {path} must not open a code fence")


def check(plan, raw: bytes) -> list[str]:
    """Every violation as one line; an empty list means the plan is valid."""
    out: list[str] = []
    if len(raw) > MAX_BYTES:
        out.append(f"size: plan.json is {len(raw)} bytes; the limit is {MAX_BYTES} (256 KiB)")
    text = raw.decode("utf-8", "replace")
    found: set[str] = set()
    for label, pat in LEAK_PATTERNS:
        m = pat.search(text)
        if m:
            line = text.count("\n", 0, m.start()) + 1
            out.append(f"secret: possible {label} on line {line}")
            found.add(label)
    m = RAW_KEY_LEAK.search(text)
    if m:
        out.append(f"secret: key {m.group(1)!r} holds a credential-sized value on line {text.count(chr(10), 0, m.start()) + 1}")
    for path, value in _strings(plan):
        for label, pat in LEAK_PATTERNS:
            if label not in found and pat.search(value):
                out.append(f"secret: possible {label} in {path}")
                found.add(label)
    if not isinstance(plan, dict):
        return out + ["root: plan.json must be a JSON object"]
    _check_text(plan, out)
    if plan.get("schema") != SCHEMA:
        out.append(f"schema: expected {SCHEMA!r}, got {plan.get('schema')!r}")
    for key in ("feature", "title"):
        if not isinstance(plan.get(key), str) or not plan.get(key).strip():
            out.append(f"{key}: must be a non-empty string")
    v = plan.get("version")
    if not _is_int(v, 1, MAX_VERSION):
        out.append(f"version: must be a positive integer up to {MAX_VERSION}, got {v!r}")
    if plan.get("status") not in PLAN_STATUS:
        out.append(f"status: {plan.get('status')!r} is not one of {'|'.join(PLAN_STATUS)}")
    for key in ("constraints", "research"):
        if key in plan and not _is_str_list(plan[key]):
            out.append(f"{key}: must be a list of strings")
    if "spec" in plan and not isinstance(plan["spec"], str):
        out.append("spec: must be a string")
    srcs = plan.get("sources", [])
    if not isinstance(srcs, list) or not all(isinstance(x, dict) and isinstance(x.get("id"), str)
                                             and isinstance(x.get("label"), str) for x in srcs):
        out.append("sources: must be a list of {id, label, href?} objects")
    ctx = plan.get("context")
    comp_ids: set[str] = set()
    if not isinstance(ctx, dict):
        out.append("context: must be an object with components")
    else:
        for key in ("summary", "archetype"):
            if key in ctx and not isinstance(ctx[key], str):
                out.append(f"context.{key}: must be a string")
        if "stack" in ctx and not _is_str_list(ctx["stack"]):
            out.append("context.stack: must be a list of strings")
        blast = ctx.get("blast", [])
        if not isinstance(blast, list):
            out.append("context.blast: must be a list")
        else:
            for i, b in enumerate(blast):
                if (not isinstance(b, dict) or not isinstance(b.get("path"), str)
                        or not _is_int(b.get("files")) or not _is_int(b.get("hits", 0))):
                    out.append(f"context.blast[{i}]: must be {{path: string, files: int, hits: int}}")
        comps = ctx.get("components", [])
        if not isinstance(comps, list):
            out.append("context.components: must be a list")
            comps = []
        for i, c in enumerate(comps):
            if not isinstance(c, dict) or not isinstance(c.get("id"), str) or not PLAIN_ID.match(c["id"]) \
                    or c["id"] in RESERVED_IDS:
                out.append(f"context.components[{i}]: needs a plain string id (letters, digits, _ . -)")
                continue
            if c["id"] in comp_ids:
                out.append(f"context.components: duplicate id {c['id']!r}")
            comp_ids.add(c["id"])
            if not isinstance(c.get("layer"), str) or not c.get("layer").strip():
                out.append(f"context.components[{c['id']}]: needs a string layer")
            if not isinstance(c.get("label"), str) or not c.get("label").strip():
                out.append(f"context.components[{c['id']}]: needs a string label")
            if "exists" in c and not isinstance(c["exists"], bool):
                out.append(f"context.components[{c['id']}]: exists must be true or false")
            if "sub" in c and not isinstance(c["sub"], str):
                out.append(f"context.components[{c['id']}]: sub must be a string")
        edges = ctx.get("edges", [])
        if not isinstance(edges, list):
            out.append("context.edges: must be a list of {from, to}")
        else:
            for i, e in enumerate(edges):
                a, b = _edge(e)
                if not isinstance(a, str) or not isinstance(b, str):
                    out.append(f"context.edges[{i}]: must be {{from: id, to: id}}")
                elif a not in comp_ids or b not in comp_ids:
                    out.append(f"context.edges[{i}]: {a!r} -> {b!r} names an unknown component")
    waves = plan.get("waves")
    wave_ids: dict[str, list] = {}
    wave_pos: dict[str, int] = {}
    if not isinstance(waves, list) or not waves:
        out.append("waves: must be a non-empty list")
        waves = []
    for i, w in enumerate(waves):
        if not isinstance(w, dict) or not isinstance(w.get("id"), str) or not PLAIN_ID.match(w["id"]) \
                or w["id"] in RESERVED_IDS:
            out.append(f"waves[{i}]: needs a plain string id")
            continue
        if w["id"] in wave_ids:
            out.append(f"waves: duplicate id {w['id']!r}")
        if "title" in w and not isinstance(w["title"], str):
            out.append(f"waves[{w['id']}]: title must be a string")
        if not _is_str_list(w.get("steps")):
            out.append(f"waves[{w['id']}]: steps must be a list of step ids")
        wave_ids[w["id"]] = w.get("steps") if _is_str_list(w.get("steps")) else []
        wave_pos.setdefault(w["id"], i)
    steps = plan.get("steps")
    if not isinstance(steps, list) or not steps:
        out.append("steps: must be a non-empty list")
        steps = []
    ids: dict[str, dict] = {}
    for i, s in enumerate(steps):
        if not isinstance(s, dict) or not isinstance(s.get("id"), str) or not STEP_ID.match(s["id"]):
            out.append(f"steps[{i}]: needs an id of the form T<n>")
            continue
        if s["id"] in ids:
            out.append(f"steps: duplicate id {s['id']!r}")
            continue
        if s["id"] != f"T{i + 1}":
            out.append(f"steps[{i}]: id {s['id']!r} must equal its 1-based position (T{i + 1})")
        ids[s["id"]] = s
    for sid, s in ids.items():
        tag = f"step {sid}"
        for key, typ in (("title", str), ("intent", str), ("kind", str), ("layer", str),
                         ("wave", str), ("parallel", bool), ("depends_on", list), ("files", dict),
                         ("touches", list), ("red", dict), ("green", dict), ("verify", list),
                         ("risk", dict), ("effort", dict), ("review", dict)):
            if key not in s:
                out.append(f"{tag}: missing field {key!r}")
            elif not isinstance(s[key], typ) or (typ is not bool and isinstance(s[key], bool)):
                out.append(f"{tag}: field {key!r} must be a {typ.__name__}")
        for key in ("title", "intent", "layer"):
            if isinstance(s.get(key), str) and not s[key].strip():
                out.append(f"{tag}: {key} must not be empty")
        if isinstance(s.get("kind"), str) and s["kind"] not in KINDS:
            out.append(f"{tag}: kind {s['kind']!r} is not one of {'|'.join(KINDS)}")
        if isinstance(s.get("wave"), str) and wave_ids and s["wave"] not in wave_ids:
            out.append(f"{tag}: wave {s['wave']!r} is not declared in waves")
        if isinstance(s.get("depends_on"), list):
            for d in s["depends_on"]:
                if not isinstance(d, str):
                    out.append(f"{tag}: depends_on entries must be step ids (strings)")
                elif d not in ids:
                    out.append(f"{tag}: depends_on {d!r} does not resolve to a step id")
                elif d == sid:
                    out.append(f"{tag}: depends on itself")
                else:
                    dep = ids[d]
                    if (isinstance(dep.get("wave"), str) and isinstance(s.get("wave"), str)
                            and dep["wave"] in wave_pos and s["wave"] in wave_pos):
                        if wave_pos[dep["wave"]] > wave_pos[s["wave"]]:
                            out.append(f"{tag}: depends on {d}, which runs in a later wave ({dep['wave']})")
                        elif (dep["wave"] == s["wave"] and s.get("parallel") is True
                              and dep.get("parallel") is False):
                            out.append(f"{tag}: a parallel step cannot depend on sequential step {d} of the "
                                       f"same wave (parallel steps run first)")
        if isinstance(s.get("touches"), list):
            for t in s["touches"]:
                if not isinstance(t, str):
                    out.append(f"{tag}: touches entries must be component ids (strings)")
                elif t not in comp_ids:
                    out.append(f"{tag}: touches {t!r} which is not in context.components")
        cmds: list[tuple[str, str]] = []
        for key in ("red", "green"):
            blk = s.get(key)
            if isinstance(blk, dict):
                run = blk.get("run")
                if not isinstance(run, str) or not run.strip():
                    out.append(f"{tag}: {key}.run must be a non-empty command")
                else:
                    cmds.append((f"{key}.run", run))
                for sub in ("test", "code", "sketch"):
                    if sub in blk and not isinstance(blk[sub], str):
                        out.append(f"{tag}: {key}.{sub} must be a string")
        ver = s.get("verify")
        if isinstance(ver, list):
            if not ver or not all(isinstance(x, str) and x.strip() for x in ver):
                out.append(f"{tag}: verify must be a non-empty list of commands")
            cmds += [("verify", x) for x in ver if isinstance(x, str)]
        for where, cmd in cmds:
            m = DESTRUCTIVE.search(cmd)
            if m:
                out.append(f"{tag}: {where} holds a destructive command form {m.group(0).strip()!r}")
        ds = s.get("diff_sketch")
        if ds is not None and (not isinstance(ds, str) or ds.count("\n") + 1 > MAX_DIFF_LINES):
            out.append(f"{tag}: diff_sketch must be a string of at most {MAX_DIFF_LINES} lines")
        files = s.get("files")
        if isinstance(files, dict):
            for key in ("create", "modify", "test"):
                lst = files.get(key, [])
                if not _is_str_list(lst):
                    out.append(f"{tag}: files.{key} must be a list of paths")
                    continue
                for p in lst:
                    if HOME_PATH.search(p):
                        out.append(f"{tag}: files.{key} has an absolute home path {p!r}")
                    elif BAD_PATH.search(p) or not p.strip():
                        out.append(f"{tag}: files.{key} path {p!r} must be relative to the project root "
                                   f"(no leading /, drive letter, ~, backslash or ..)")
        for key in ("screens",):
            if key in s and not _is_str_list(s[key]):
                out.append(f"{tag}: {key} must be a list of paths")
        risk = s.get("risk")
        if isinstance(risk, dict):
            if risk.get("level") not in RISK_LEVELS:
                out.append(f"{tag}: risk.level {risk.get('level')!r} is not one of {'|'.join(RISK_LEVELS)}")
            if "note" in risk and not isinstance(risk["note"], str):
                out.append(f"{tag}: risk.note must be a string")
        eff = s.get("effort")
        if isinstance(eff, dict) and not _is_int(eff.get("minutes"), 0, 100000):
            out.append(f"{tag}: effort.minutes must be a non-negative integer")
        rev = s.get("review")
        if isinstance(rev, dict):
            if rev.get("status") not in REVIEW_STATUS:
                out.append(f"{tag}: review.status {rev.get('status')!r} is not one of {'|'.join(REVIEW_STATUS)}")
            for key in ("note", "edited_text"):
                if key in rev and not isinstance(rev[key], str):
                    out.append(f"{tag}: review.{key} must be a string")
        hist = s.get("history")
        if hist is not None:
            if not isinstance(hist, list):
                out.append(f"{tag}: history must be a list")
            else:
                for i, h in enumerate(hist):
                    if (not isinstance(h, dict) or not _is_int(h.get("v"), 1) or not _is_str_list(h.get("changed"))
                            or any(k in h and not isinstance(h[k], str) for k in ("summary", "diff"))):
                        out.append(f"{tag}: history[{i}] must be {{v: int, changed: [field, …], summary?, diff?}}")
        info = s.get("infographic")
        if info is not None:
            if (not isinstance(info, dict) or info.get("type") not in ("bar", "line", "pie")
                    or not isinstance(info.get("title"), str)
                    or not isinstance(info.get("data"), list) or not info["data"]
                    or not all(isinstance(r, list) and len(r) == 2 and isinstance(r[0], str)
                               and isinstance(r[1], (int, float)) and not isinstance(r[1], bool)
                               and r[1] == r[1] and abs(r[1]) != float("inf")
                               for r in info["data"])):
                out.append(f"{tag}: infographic must be {{type: bar|line|pie, title, data: [[label, number], …]}}")
            elif len(info["data"]) > MAX_INFOGRAPHIC_ROWS:
                out.append(f"{tag}: infographic.data has {len(info['data'])} rows; the limit is {MAX_INFOGRAPHIC_ROWS}")
    # dependency cycles (DFS over resolvable edges)
    graph = {sid: [d for d in (s.get("depends_on") or []) if isinstance(d, str) and d in ids and d != sid]
             for sid, s in ids.items()}
    state: dict[str, int] = {}
    cycle: list[str] | None = None

    def visit(node: str, path: list[str]) -> None:
        nonlocal cycle
        if cycle:
            return
        state[node] = 1
        for nxt in graph[node]:
            if state.get(nxt) == 1:
                cycle = path[path.index(nxt):] + [nxt]
                return
            if nxt not in state:
                visit(nxt, path + [nxt])
        state[node] = 2

    for sid in sorted(ids, key=lambda x: int(x[1:])):
        if sid not in state:
            visit(sid, [sid])
    if cycle:
        out.append("depends_on: dependency cycle " + " -> ".join(reversed(cycle)))
    membership: dict[str, list[str]] = {sid: [] for sid in ids}
    for wid, wsteps in wave_ids.items():
        for st in wsteps:
            if st not in ids:
                out.append(f"wave {wid}: step {st!r} does not exist")
            else:
                membership[st].append(wid)
        # parallel steps inside one wave never share a create, modify or test path
        seen: dict[str, tuple[str, str]] = {}
        for st in wsteps:
            s = ids.get(st)
            if not s or s.get("parallel") is not True or not isinstance(s.get("files"), dict):
                continue
            for key in ("modify", "create", "test"):
                for p in s["files"].get(key, []) or []:
                    if not isinstance(p, str):
                        continue
                    p = norm_path(p)
                    if p in seen and seen[p][0] != st:
                        out.append(f"wave {wid}: parallel steps {seen[p][0]} and {st} both {seen[p][1]} {p!r}")
                    else:
                        seen.setdefault(p, (st, key))
    for sid, s in ids.items():
        if isinstance(s.get("wave"), str) and s["wave"] in wave_ids and sid not in wave_ids[s["wave"]]:
            out.append(f"step {sid}: not listed in wave {s['wave']}")
        if wave_ids and not membership[sid]:
            out.append(f"step {sid}: not listed in any wave")
        elif len(membership[sid]) > 1:
            out.append(f"step {sid}: listed in more than one wave ({', '.join(membership[sid])})")
    return out


def warnings_of(plan: dict) -> list[str]:
    """Advisory lines (stderr): inconsistent metrics, dependencies on deferred steps."""
    out = metrics_warnings(plan)
    by = step_index(plan)
    for s in steps_of(plan):
        if is_deferred(s):
            continue
        for d in s.get("depends_on") or []:
            if isinstance(d, str) and d in by and is_deferred(by[d]):
                out.append(f"step {s['id']}: depends on {d}, which is deferred — un-defer {d} or defer {s['id']} too")
    return out


def metrics_of(plan: dict) -> dict:
    """Derived totals (the schema documents `metrics` as optional; this is the source of truth)."""
    steps = steps_of(plan)
    by_layer: dict[str, int] = {}
    for s in steps:
        by_layer[str(s.get("layer", ""))] = by_layer.get(str(s.get("layer", "")), 0) + 1
    par = sum(1 for s in steps if s.get("parallel") is True)
    mins = sum(minutes_of(s) for s in steps)
    return {"steps": len(steps), "parallel": par, "sequential": len(steps) - par,
            "minutes": int(mins) if float(mins).is_integer() else mins, "by_layer": by_layer}


def metrics_warnings(plan: dict) -> list[str]:
    given = plan.get("metrics")
    if not isinstance(given, dict):
        return []
    derived = metrics_of(plan)
    return [f"metrics.{k}: plan says {given[k]!r}, steps give {derived[k]!r} (metrics are derived from steps; the plan's copy is ignored)"
            for k in ("steps", "parallel", "sequential", "minutes", "by_layer")
            if k in given and given[k] != derived[k]]


# ───────────────────────────────── helpers ──────────────────────────────────────
def steps_of(plan: dict) -> list[dict]:
    return [s for s in plan.get("steps", []) if isinstance(s, dict)]


def step_index(plan: dict) -> dict[str, dict]:
    return {s["id"]: s for s in steps_of(plan)}


def task_numbers(plan: dict) -> dict[str, int]:
    """Task N is the step's 1-based position in `steps`; deferral never renumbers the others."""
    return {s["id"]: i + 1 for i, s in enumerate(steps_of(plan))}


def review_of(s: dict) -> dict:
    r = s.get("review")
    return r if isinstance(r, dict) else {"status": "pending"}


def is_deferred(s: dict) -> bool:
    return review_of(s).get("status") == "deferred"


def minutes_of(s: dict) -> float:
    e = s.get("effort") or {}
    m = e.get("minutes", 0)
    return m if isinstance(m, (int, float)) and not isinstance(m, bool) else 0


def layers_of(plan: dict) -> list[str]:
    out: list[str] = []
    for c in (plan.get("context") or {}).get("components", []) or []:
        lay = c.get("layer") if isinstance(c, dict) else None
        if isinstance(lay, str) and lay not in out:
            out.append(lay)
    for s in steps_of(plan):
        lay = s.get("layer")
        if isinstance(lay, str) and lay not in out:
            out.append(lay)
    return out


def esc(s) -> str:
    return html.escape(str(s), quote=True)


# ───────────────────────────────── plan.md ──────────────────────────────────────
def mermaid_source(plan: dict) -> str:
    """The wave/dependency graph as a Mermaid block (readable on GitHub; drawn as SVG in plan.html)."""
    by = step_index(plan)
    lines = ["graph LR"]
    for w in plan.get("waves", []):
        lines.append(f'  subgraph {w["id"]}["{_mm(w["id"] + " " + str(w.get("title", "")))}"]')
        for sid in w.get("steps", []):
            s = by.get(sid)
            if not s:
                continue
            title = str(s.get("title", ""))
            short = title[:28] + ("…" if len(title) > 28 else "")
            lines.append(f'    {sid}["{_mm(sid + " " + short)}"]')
        lines.append("  end")
    for s in steps_of(plan):
        for d in s.get("depends_on", []) or []:
            if d in by:
                lines.append(f"  {d} --> {s['id']}")
    return "\n".join(lines)


def _mm(s: str) -> str:
    return s.replace('"', "'").replace("[", "(").replace("]", ")")


def _code(s: str) -> str:
    s = str(s).replace("\n", " ")
    return "`" + s.replace("`", "'") + "`"


def task_block(plan: dict, s: dict) -> str:
    nums = task_numbers(plan)
    by = step_index(plan)
    files = s.get("files") or {}
    red = s.get("red") or {}
    green = s.get("green") or {}
    risk = s.get("risk") or {}
    rev = review_of(s)
    deps = [d for d in (s.get("depends_on") or []) if d in nums]
    dep_txt = ", ".join(f"Task {nums[d]}" for d in deps)
    par = "YES" if s.get("parallel") else "NO"
    if dep_txt:
        par += f" (depends on {dep_txt})"
    o = [f"### Task {nums[s['id']]}: {s.get('title', '')} ({s['id']})",
         f"Parallel: {par}",
         "",
         f"Wave: {s.get('wave', '')} · Kind: {s.get('kind', '')} · Layer: {s.get('layer', '')}",
         "",
         str(s.get("intent", "")).strip(),
         "",
         "**Files:**"]
    for label, key in (("Create", "create"), ("Modify", "modify"), ("Test", "test")):
        lst = files.get(key) or []
        o.append(f"- {label}: " + (", ".join(_code(p) for p in lst) if lst else "—"))
    o.append("")
    red_test = str(red.get("test", "")).strip()
    red_code = str(red.get("code", "")).strip()
    sketch = str(green.get("sketch", "")).strip()
    fences: list[str] = []
    if "\n" in red_code:
        o.append("- [ ] Write failing test: " + red_test + " — see the test code below")
        fences.append("**Test code:**\n\n```\n" + red_code + "\n```")
    else:
        o.append("- [ ] Write failing test: " + red_test + (f" — {_code(red_code)}" if red_code else ""))
    o.append("- [ ] Run test: verify FAIL — " + _code(red.get("run", "")))
    if "\n" in sketch:
        o.append("- [ ] Implement: see the implementation sketch below")
        fences.append("**Implementation sketch:**\n\n```\n" + sketch + "\n```")
    else:
        o.append("- [ ] Implement: " + sketch)
    o.append("- [ ] Run test: verify PASS — " + _code(green.get("run") or red.get("run", "")))
    o.append(f'- [ ] Commit: `git commit -m "feat: {_commit_msg(s)}"`')
    o.append("")
    for f in fences:
        o += [f, ""]
    o.append("**Verify:** " + " && ".join(_code(v) for v in (s.get("verify") or [])))
    o.append(f"**Touches:** {', '.join(s.get('touches') or []) or '—'}")
    note = str(risk.get("note", "")).strip()
    o.append(f"**Risk:** {risk.get('level', '')}" + (f" — {note}" if note else ""))
    o.append(f"**Effort:** {fmt_num(minutes_of(s))} min")
    if s.get("diff_sketch"):
        o += ["", "```diff", str(s["diff_sketch"]).rstrip("\n"), "```"]
    rnote = str(rev.get("note", "")).strip()
    o.append("")
    o.append(f"Review: {rev.get('status', 'pending')}" + (f" ({rnote})" if rnote else ""))
    if rev.get("status") == "edited" and str(rev.get("edited_text", "")).strip():
        o += ["", "**Reviewer edit:**"]
        o += ["> " + line.replace("`", "'") for line in str(rev["edited_text"]).strip().splitlines()]
    if deps:
        o.append(f"Depends on: {', '.join(deps)}")
    return "\n".join(o) + "\n"


def _commit_msg(s: dict) -> str:
    """A conventional-commit subject from the title: shell-significant characters removed so the
    line is safe to paste into a shell."""
    t = re.sub(r"[\x00-\x1f\x7f$`\\\"'!<>|&;]", "", str(s.get("title", "")))
    t = re.sub(r"\s+", " ", t).strip()
    return t[:60].rstrip() or s.get("id", "step")


def render_md(plan: dict) -> str:
    steps = steps_of(plan)
    active = [s for s in steps if not is_deferred(s)]
    deferred = [s for s in steps if is_deferred(s)]
    par = sum(1 for s in active if s.get("parallel"))
    mins = sum(minutes_of(s) for s in active)
    ctx = plan.get("context") or {}
    o = [f"# Plan: {plan.get('title', '')}", "",
         f"Version: v{plan.get('version', '')} · Status: {plan.get('status', '')} · Spec: "
         f"{_code(plan.get('spec', '')) if plan.get('spec') else '—'}", "",
         f"Feature: {plan.get('feature', '')} · Steps: {len(active)} ({par} parallel, {len(active) - par} sequential)"
         f"{f' · {len(deferred)} deferred' if deferred else ''} · ~{fmt_num(round(mins / 60, 1))} h",
         ""]
    for r in plan.get("research", []) or []:
        o.append(f"- Research: {_code(r)}")
    if plan.get("research"):
        o.append("")
    o += ["## Global Constraints", "_Every task inherits these — do not restate per task._"]
    cons = plan.get("constraints") or []
    o += [f"- {c}" for c in cons] or ["- (none)"]
    o.append("")
    if ctx:
        o += ["## Context", ""]
        if ctx.get("summary"):
            o += [str(ctx["summary"]).strip(), ""]
        if ctx.get("stack"):
            o += ["Stack: " + ", ".join(str(x) for x in ctx["stack"]), ""]
        blast = ctx.get("blast") or []
        if blast:
            o += ["| Blast radius | Files | Hits |", "|---|---|---|"]
            o += [f"| {_code(b.get('path', ''))} | {fmt_num(b.get('files', 0))} | {fmt_num(b.get('hits', 0))} |"
                  for b in blast if isinstance(b, dict)]
            o.append("")
    by = step_index(plan)
    o += ["## Waves", ""]
    for w in plan.get("waves", []):
        names = []
        for sid in w.get("steps", []):
            s = by.get(sid)
            tag = "deferred" if s and is_deferred(s) else "parallel" if s and s.get("parallel") else "sequential"
            names.append(f"{sid} ({tag})")
        o.append(f"- {w['id']} {w.get('title', '')}: " + (", ".join(names) or "—"))
    o += ["", "```mermaid", mermaid_source(plan), "```", "",
          "> Execute waves in order; inside a wave, tasks marked *Parallel: YES* may run concurrently "
          "(they never share a modified file). Deferred tasks are listed at the end and are not executed.",
          "", "## Tasks", ""]
    o += [task_block(plan, s) for s in active]
    if deferred:
        o += ["## Deferred — not executed this run", ""]
        o += [task_block(plan, s) for s in deferred]
    srcs = plan.get("sources") or []
    if srcs:
        o += ["## Sources", ""]
        for src in srcs:
            if isinstance(src, dict):
                lab = str(src.get("label", ""))
                href = src.get("href")
                o.append(f"- {src.get('id', '')}: " + (f"[{lab}]({href})" if href else lab))
        o.append("")
    o.append(f"<!-- {SCHEMA} v{plan.get('version', '')} sha256:{plan_hash(plan)} -->")
    return "\n".join(o) + "\n"


# ───────────────────────── Markdown subset → HTML (stdlib) ───────────────────────
_INLINE_CODE = re.compile(r"`([^`]+)`")
_BOLD = re.compile(r"\*\*(.+?)\*\*")
_ITAL = re.compile(r"(?<![\w*])\*(?!\s)([^*]+?)(?<!\s)\*(?![\w*])")
_ITAL_U = re.compile(r"(?<![\w_])_(?!\s)([^_]+?)(?<!\s)_(?![\w_])")
_LINK = re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")


def _inline(text: str) -> str:
    """Inline code, bold, italic, links; everything else HTML-escaped."""
    parts: list[str] = []
    pos = 0
    for m in _INLINE_CODE.finditer(text):
        parts.append(_inline_text(text[pos:m.start()]))
        parts.append("<code>" + esc(m.group(1)) + "</code>")
        pos = m.end()
    parts.append(_inline_text(text[pos:]))
    return "".join(parts)


def _inline_text(t: str) -> str:
    t = esc(t)
    t = _BOLD.sub(r"<strong>\1</strong>", t)
    t = _ITAL.sub(r"<em>\1</em>", t)
    t = _ITAL_U.sub(r"<em>\1</em>", t)
    t = _LINK.sub(lambda m: '<a href="%s">%s</a>' % (m.group(2), m.group(1))
                  if re.match(r"(?i)^(https?:|#|\.|/|[\w.-]+/|[\w.-]+\.md)", m.group(2))
                  else m.group(0), t)
    return t


def md_to_html(md: str, mermaid_svg: str | None = None) -> str:
    """A small, predictable Markdown subset: headings, bullet/numbered lists, task lists, pipe
    tables, fenced code, blockquotes, paragraphs, HTML comments (dropped). A ```mermaid fence is
    replaced by `mermaid_svg` when given."""
    lines = md.replace("\r\n", "\n").split("\n")
    out: list[str] = []
    i = 0
    n = len(lines)
    while i < n:
        line = lines[i]
        if not line.strip():
            i += 1
            continue
        if line.startswith("```"):
            lang = line[3:].strip()
            body: list[str] = []
            i += 1
            while i < n and not lines[i].startswith("```"):
                body.append(lines[i])
                i += 1
            i += 1
            if lang == "mermaid" and mermaid_svg:
                out.append('<div class="graph">' + mermaid_svg + "</div>")
            else:
                cls = f' class="language-{esc(lang)}"' if lang else ""
                if lang == "diff":
                    rows = ['<span class="add">' + esc(b) + "</span>" if b.startswith("+")
                            else '<span class="del">' + esc(b) + "</span>" if b.startswith("-")
                            else esc(b) for b in body]
                    out.append(f"<pre><code{cls}>" + "\n".join(rows) + "</code></pre>")
                else:
                    out.append(f"<pre><code{cls}>" + esc("\n".join(body)) + "</code></pre>")
            continue
        m = re.match(r"^(#{1,6})\s+(.*?)\s*#*$", line)
        if m:
            lvl = len(m.group(1))
            out.append(f"<h{lvl}>{_inline(m.group(2))}</h{lvl}>")
            i += 1
            continue
        if line.lstrip().startswith("<!--"):
            # Only a one-line comment (the plan.md trailer) is dropped; anything else that looks like
            # a comment is shown escaped, so plan text can never swallow the document.
            if "-->" not in line:
                out.append("<p>" + esc(line.strip()) + "</p>")
            i += 1
            continue
        if line.startswith(">"):
            quote: list[str] = []
            while i < n and lines[i].startswith(">"):
                quote.append(lines[i][1:].strip())
                i += 1
            out.append("<blockquote><p>" + _inline(" ".join(quote)) + "</p></blockquote>")
            continue
        if "|" in line and i + 1 < n and re.match(r"^\s*\|?\s*:?-{3,}", lines[i + 1]):
            head = _cells(line)
            i += 2
            rows: list[list[str]] = []
            while i < n and lines[i].strip().startswith("|"):
                rows.append(_cells(lines[i]))
                i += 1
            t = "<table><thead><tr>" + "".join(f"<th>{_inline(c)}</th>" for c in head) + "</tr></thead>"
            if rows:
                t += "<tbody>" + "".join("<tr>" + "".join(f"<td>{_inline(c)}</td>" for c in r) + "</tr>"
                                         for r in rows) + "</tbody>"
            out.append(t + "</table>")
            continue
        lm = re.match(r"^(\s*)([-*]|\d+\.)\s+(.*)$", line)
        if lm:
            ordered = lm.group(2)[0].isdigit()
            tag = "ol" if ordered else "ul"
            items: list[str] = []
            while i < n:
                lm = re.match(r"^(\s*)([-*]|\d+\.)\s+(.*)$", lines[i])
                if not lm or lm.group(2)[0].isdigit() != ordered:
                    break
                body_txt = lm.group(3)
                tm = re.match(r"^\[([ xX])\]\s*(.*)$", body_txt)
                if tm:
                    checked = " checked" if tm.group(1).lower() == "x" else ""
                    items.append('<li class="task"><input type="checkbox" disabled' + checked + "> "
                                 + _inline(tm.group(2)) + "</li>")
                else:
                    items.append("<li>" + _inline(body_txt) + "</li>")
                i += 1
            out.append(f"<{tag}>" + "".join(items) + f"</{tag}>")
            continue
        para: list[str] = []
        while i < n and lines[i].strip() and not re.match(r"^(#{1,6}\s|```|>|\s*([-*]|\d+\.)\s|\s*\|)", lines[i]) \
                and not (lines[i].lstrip().startswith("<!--") and para):
            para.append(lines[i].strip())
            i += 1
        if para:
            out.append("<p>" + _inline(" ".join(para)) + "</p>")
        else:
            i += 1
    return "\n".join(out) + "\n"


def _cells(line: str) -> list[str]:
    s = line.strip()
    if s.startswith("|"):
        s = s[1:]
    if s.endswith("|"):
        s = s[:-1]
    return [c.strip() for c in re.split(r"(?<!\\)\|", s)]


# ───────────────────────────── SVG: wave graph + charts ──────────────────────────
def wave_graph_svg(plan: dict) -> str:
    """Boxes per step grouped by wave (columns), arrows for depends_on. Deterministic, no library."""
    by = step_index(plan)
    waves = [w for w in plan.get("waves", []) if isinstance(w, dict)]
    colw, boxw, boxh, gap, top = 220, 180, 44, 14, 44
    rows = max([len([s for s in w.get("steps", []) if s in by]) for w in waves] or [1])
    W = max(1, len(waves)) * colw + 20
    H = top + rows * (boxh + gap) + 16
    pos: dict[str, tuple] = {}
    body: list[str] = []
    for wi, w in enumerate(waves):
        x0 = 10 + wi * colw
        body.append(f'<rect class="wave" x="{x0}" y="8" width="{colw - 16}" height="{H - 16}" rx="10"/>')
        body.append(f'<text class="wavelabel" x="{x0 + 12}" y="30">{esc(w["id"])} · {esc(w.get("title", ""))}</text>')
        k = 0
        for sid in w.get("steps", []):
            s = by.get(sid)
            if not s:
                continue
            x, y = x0 + 12, top + k * (boxh + gap)
            pos[sid] = (x, y)
            k += 1
    for s in steps_of(plan):
        for d in s.get("depends_on", []) or []:
            if d in pos and s["id"] in pos:
                ax, ay = pos[d]
                bx, by_ = pos[s["id"]]
                sx, sy = ax + boxw, ay + boxh / 2
                tx, ty = bx, by_ + boxh / 2
                if bx <= ax:  # same column (or earlier): route around the right side
                    sx, sy, tx, ty = ax + boxw / 2, ay + boxh, bx + boxw / 2, by_
                    mid = (sy + ty) / 2
                    body.append(f'<path class="dep" d="M{sx:g},{sy:g} C{sx:g},{mid:g} {tx:g},{mid:g} {tx:g},{ty:g}" marker-end="url(#arrow)"/>')
                else:
                    mid = (sx + tx) / 2
                    body.append(f'<path class="dep" d="M{sx:g},{sy:g} C{mid:g},{sy:g} {mid:g},{ty:g} {tx:g},{ty:g}" marker-end="url(#arrow)"/>')
    for sid, (x, y) in pos.items():
        s = by[sid]
        title = str(s.get("title", ""))
        short = title[:24] + ("…" if len(title) > 24 else "")
        cls = "step deferred" if is_deferred(s) else ("step seq" if not s.get("parallel") else "step")
        body.append(f'<g class="{cls}" data-step="{esc(sid)}"><rect x="{x}" y="{y}" width="{boxw}" height="{boxh}" rx="8"/>'
                    f'<text class="id" x="{x + 10}" y="{y + 18}">{esc(sid)}</text>'
                    f'<text class="t" x="{x + 10}" y="{y + 34}">{esc(short)}</text><title>{esc(sid + " " + title)}</title></g>')
    desc = "; ".join(f"{w['id']}: {', '.join(w.get('steps', []))}" for w in waves)
    return (f'<svg class="wavegraph" viewBox="0 0 {W} {H}" role="img" aria-labelledby="wg-title wg-desc">'
            f'<title id="wg-title">Waves and dependencies</title><desc id="wg-desc">{esc(desc)}</desc>'
            '<defs><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">'
            '<path d="M0,0 L10,5 L0,10 z"/></marker></defs>' + "".join(body) + "</svg>")


def mermaid_via_mmdc(src: str) -> str | None:
    exe = shutil.which("mmdc")
    if not exe:
        return None
    tmp = tempfile.mkdtemp(prefix="plan-render-")
    try:
        inp, outp = os.path.join(tmp, "graph.mmd"), os.path.join(tmp, "graph.svg")
        with open(inp, "w", encoding="utf-8") as fh:
            fh.write(src)
        r = subprocess.run([exe, "-q", "-i", inp, "-o", outp], capture_output=True, text=True, timeout=120)
        if r.returncode != 0 or not os.path.exists(outp):
            return None
        with open(outp, encoding="utf-8") as fh:
            svg = fh.read()
        return svg if svg.lstrip().startswith("<svg") else None
    except (OSError, subprocess.SubprocessError):
        return None
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def _sr_table(title: str, rows: list[tuple[str, str]], head: tuple[str, str] = ("Item", "Value")) -> str:
    return ('<table class="sr"><caption>' + esc(title) + "</caption><thead><tr><th>" + esc(head[0]) + "</th><th>"
            + esc(head[1]) + "</th></tr></thead><tbody>"
            + "".join(f"<tr><th>{esc(a)}</th><td>{esc(b)}</td></tr>" for a, b in rows) + "</tbody></table>")


def _chart(key: str, title: str, svg_body: str, vb: tuple[int, int], desc: str, rows, head=("Item", "Value")) -> str:
    cid = "c-" + re.sub(r"[^a-z0-9]+", "-", key.lower())
    return (f'<div class="chart" data-chart="{esc(key)}"><div class="label">{esc(title)}</div>'
            f'<svg viewBox="0 0 {vb[0]} {vb[1]}" role="img" aria-labelledby="{cid}-t {cid}-d">'
            f'<title id="{cid}-t">{esc(title)}</title><desc id="{cid}-d">{esc(desc)}</desc>{svg_body}</svg>'
            + _sr_table(title, rows, head) + "</div>")


def chart_bar(key: str, title: str, data: list[tuple[str, float]], alt: bool = False, unit: str = "") -> str:
    W, H, pl, pb = 320, 170, 36, 34
    mx = max([d[1] for d in data] or [1]) or 1
    bw = (W - pl - 10) / len(data)
    parts = []
    for i, (lab, val) in enumerate(data):
        h = (H - pb - 14) * val / mx
        x = pl + i * bw + bw * 0.15
        y = H - pb - h
        cls = "bar hatch" if alt and i % 2 else "bar"
        short = lab if len(lab) <= 11 else lab[:10] + "…"
        fs = 9 if len(data) > 4 else 11
        parts.append(f'<rect class="{cls}" x="{x:.1f}" y="{y:.1f}" width="{bw * .7:.1f}" height="{h:.1f}" rx="3"><title>{esc(lab)}: {fmt_num(val)}</title></rect>'
                     f'<text x="{x + bw * .35:.1f}" y="{y - 4:.1f}" text-anchor="middle">{fmt_num(val)}</text>'
                     f'<text x="{x + bw * .35:.1f}" y="{H - pb + 14}" text-anchor="middle" font-size="{fs}">{esc(short)}</text>')
    body = f'<line class="axis" x1="{pl}" y1="{H - pb}" x2="{W - 4}" y2="{H - pb}"/>' + "".join(parts)
    desc = "; ".join(f"{lab} {fmt_num(val)}{unit}" for lab, val in data)
    return _chart(key, title, body, (W, H), desc, [(lab, fmt_num(val) + unit) for lab, val in data])


def chart_hbar(key: str, title: str, data: list[tuple[str, float]], unit: str = "") -> str:
    rowh, pl, W = 22, 150, 420
    H = len(data) * rowh + 24
    mx = max([d[1] for d in data] or [1]) or 1
    parts = []
    for i, (lab, val) in enumerate(data):
        y = 8 + i * rowh
        w = (W - pl - 50) * val / mx
        short = lab if len(lab) <= 22 else "…" + lab[-21:]
        parts.append(f'<text x="{pl - 8}" y="{y + 14}" text-anchor="end">{esc(short)}</text>'
                     f'<rect class="bar{" hatch" if i % 2 else ""}" x="{pl}" y="{y + 3}" width="{w:.1f}" height="{rowh - 7}" rx="3"><title>{esc(lab)}: {fmt_num(val)}</title></rect>'
                     f'<text x="{pl + w + 6:.1f}" y="{y + 14}">{fmt_num(val)}</text>')
    body = f'<line class="axis" x1="{pl}" y1="4" x2="{pl}" y2="{H - 12}"/>' + "".join(parts)
    desc = "; ".join(f"{lab} {fmt_num(val)}{unit}" for lab, val in data)
    return _chart(key, title, body, (W, H), desc, [(lab, fmt_num(val) + unit) for lab, val in data])


def chart_donut(key: str, title: str, data: list[tuple[str, float]]) -> str:
    import math
    total = sum(d[1] for d in data) or 1
    cols = ["var(--accent)", "var(--ok)", "var(--warn)", "var(--ink-3)", "var(--stop)", "var(--ink-2)"]
    a0 = -math.pi / 2
    segs = []
    r, cx, cy = 60, 80, 80
    for i, (lab, val) in enumerate(data):
        a1 = a0 + 2 * math.pi * val / total
        if val >= total:  # a single full circle cannot be drawn as one arc
            segs.append(f'<circle cx="{cx}" cy="{cy}" r="{r}" fill="none" stroke="{cols[i % 6]}" stroke-width="22"><title>{esc(lab)}: {fmt_num(val)}</title></circle>')
        else:
            x0, y0 = cx + r * math.cos(a0), cy + r * math.sin(a0)
            x1, y1 = cx + r * math.cos(a1), cy + r * math.sin(a1)
            big = 1 if a1 - a0 > math.pi else 0
            dash = ' stroke-dasharray="6 3"' if i % 2 else ""
            segs.append(f'<path d="M{x0:.1f},{y0:.1f} A{r},{r} 0 {big} 1 {x1:.1f},{y1:.1f}" fill="none" stroke="{cols[i % 6]}" stroke-width="22"{dash}><title>{esc(lab)}: {fmt_num(val)}</title></path>')
        a0 = a1
    leg = "".join(f'<text x="170" y="{40 + i * 20}"><tspan fill="{cols[i % 6]}">■</tspan> {esc(lab)} — {fmt_num(val)} min ({round(100 * val / total)}%)</text>'
                  for i, (lab, val) in enumerate(data))
    centre = f'<text class="big" x="{cx}" y="{cy + 5}" text-anchor="middle">{fmt_num(round(total / 60, 1))} h</text>'
    H = max(170, 40 + len(data) * 20)
    desc = "; ".join(f"{lab} {fmt_num(val)} min" for lab, val in data)
    return _chart(key, title, "".join(segs) + centre + leg, (320, H), desc, [(lab, fmt_num(val) + " min") for lab, val in data])


def chart_line(key: str, title: str, data: list[tuple[str, float]]) -> str:
    W, H, pl, pb = 320, 170, 36, 34
    mx = max([d[1] for d in data] or [1]) or 1
    n = max(1, len(data) - 1)
    pts = []
    labels = []
    for i, (lab, val) in enumerate(data):
        x = pl + (W - pl - 14) * i / n
        y = H - pb - (H - pb - 20) * val / mx
        pts.append(f"{x:.1f},{y:.1f}")
        labels.append(f'<circle class="dot" cx="{x:.1f}" cy="{y:.1f}" r="4"><title>{esc(lab)}: {fmt_num(val)}</title></circle>'
                      f'<text x="{x:.1f}" y="{H - pb + 14}" text-anchor="middle" font-size="9">{esc(lab[:10])}</text>'
                      f'<text x="{x:.1f}" y="{y - 8:.1f}" text-anchor="middle">{fmt_num(val)}</text>')
    body = (f'<line class="axis" x1="{pl}" y1="{H - pb}" x2="{W - 4}" y2="{H - pb}"/>'
            f'<polyline class="series" points="{" ".join(pts)}"/>' + "".join(labels))
    desc = "; ".join(f"{lab} {fmt_num(val)}" for lab, val in data)
    return _chart(key, title, body, (W, H), desc, [(lab, fmt_num(val)) for lab, val in data])


def chart_gantt(plan: dict) -> str:
    steps = steps_of(plan)
    by = step_index(plan)
    start: dict[str, float] = {}
    for s in steps:  # steps are listed in wave order, so one pass resolves dependencies declared earlier
        deps = [d for d in (s.get("depends_on") or []) if d in start]
        start[s["id"]] = max([start[d] + minutes_of(by[d]) for d in deps] or [0])
    span = max([start[s["id"]] + minutes_of(s) for s in steps] or [1]) or 1
    W, rowh, pl = 640, 18, 40
    H = len(steps) * rowh + 30
    sc = (W - pl - 10) / span
    rows = []
    for i, s in enumerate(steps):
        y = 10 + i * rowh
        x = pl + start[s["id"]] * sc
        w = max(4, minutes_of(s) * sc)
        cls = "task" + (" seq" if not s.get("parallel") else "") + (" deferred" if is_deferred(s) else "")
        rows.append(f'<text x="2" y="{y + 13}">{esc(s["id"])}</text>'
                    f'<rect class="{cls}" data-step="{esc(s["id"])}" x="{x:.1f}" y="{y + 3}" width="{w:.1f}" height="{rowh - 6}" rx="3">'
                    f'<title>{esc(s["id"])} {esc(s.get("title", ""))} — {fmt_num(minutes_of(s))} min, starts at {fmt_num(start[s["id"]])}</title></rect>')
    body = ("".join(rows) + f'<line class="axis" x1="{pl}" y1="{H - 12}" x2="{W - 10}" y2="{H - 12}"/>'
            f'<text x="{pl}" y="{H - 1}">0</text><text x="{W - 10}" y="{H - 1}" text-anchor="end">{fmt_num(span)} min end-to-end</text>')
    desc = f"Dependency-ordered timeline; {fmt_num(span)} minutes end to end. Highlighted bar: the current step; hatched: sequential."
    return _chart("critical_path", "Critical path (minutes, dependency-ordered)", body, (W, H), desc,
                  [(s["id"], f"start {fmt_num(start[s['id']])}, {fmt_num(minutes_of(s))} min") for s in steps],
                  ("Step", "Start, duration"))


def chart_risk(plan: dict) -> str:
    steps = steps_of(plan)
    W, H, cell, ox, oy = 320, 190, 50, 50, 10
    grid = []
    for r in range(3):
        for e in range(3):
            tone = "stop" if r + e >= 3 else "warn" if r + e >= 2 else "ok"
            grid.append(f'<rect class="cell {tone}" x="{ox + e * cell}" y="{oy + (2 - r) * cell}" width="{cell}" height="{cell}"/>')
    pts = []
    seen: dict[tuple, int] = {}
    for s in steps:
        r = {"low": 0, "medium": 1, "high": 2}.get((s.get("risk") or {}).get("level"), 0)
        m = minutes_of(s)
        e = 2 if m > 90 else 1 if m > 40 else 0
        k = seen.get((r, e), 0)
        seen[(r, e)] = k + 1
        x = ox + e * cell + 12 + (k % 3) * 13
        y = oy + (2 - r) * cell + 14 + (k // 3) * 14
        pts.append(f'<circle class="dot" data-step="{esc(s["id"])}" cx="{x}" cy="{y}" r="5"><title>{esc(s["id"])} {esc(s.get("title", ""))} — {esc((s.get("risk") or {}).get("level", ""))} risk, {fmt_num(m)} min</title></circle>')
    labels = (f'<text x="{ox - 6}" y="{oy + cell * 2.5 + 4:g}" text-anchor="end">low</text>'
              f'<text x="{ox - 6}" y="{oy + cell * 1.5 + 4:g}" text-anchor="end">med</text>'
              f'<text x="{ox - 6}" y="{oy + cell * .5 + 4:g}" text-anchor="end">high</text>'
              f'<text x="{ox + cell * .5:g}" y="{oy + cell * 3 + 16}" text-anchor="middle">≤40 min</text>'
              f'<text x="{ox + cell * 1.5:g}" y="{oy + cell * 3 + 16}" text-anchor="middle">≤90</text>'
              f'<text x="{ox + cell * 2.5:g}" y="{oy + cell * 3 + 16}" text-anchor="middle">&gt;90</text>'
              f'<text x="8" y="{oy + cell * 1.5:g}" transform="rotate(-90 8 {oy + cell * 1.5:g})" text-anchor="middle">risk</text>')
    rows = [(s["id"], f"{(s.get('risk') or {}).get('level', '')} risk, {fmt_num(minutes_of(s))} min") for s in steps]
    return _chart("risk_matrix", "Risk × effort (each dot is a step)", "".join(grid) + "".join(pts) + labels, (W, H),
                  "Rows: risk low to high; columns: effort up to 40, 90 and over 90 minutes.", rows, ("Step", "Risk, effort"))


def charts_html(plan: dict) -> str:
    """Every applicable chart (§5.3 rules), each as <div class="chart" data-chart=…>; the page clones
    them into the side panel. Charts render only where the plan has the data."""
    steps = steps_of(plan)
    waves = [w for w in plan.get("waves", []) if isinstance(w, dict)]
    ctx = plan.get("context") or {}
    out = []
    if len(waves) >= 2:
        out.append(chart_bar("tasks_per_wave", "Tasks per wave", [(w["id"], len(w.get("steps", []))) for w in waves]))
    if steps:
        par = sum(1 for s in steps if s.get("parallel"))
        out.append(chart_bar("parallel_vs_sequential", "Parallel vs sequential", [("parallel", par), ("sequential", len(steps) - par)], alt=True))
    by_layer: dict[str, float] = {}
    for s in steps:
        if minutes_of(s) > 0:
            by_layer[str(s.get("layer", ""))] = by_layer.get(str(s.get("layer", "")), 0) + minutes_of(s)
    if len(by_layer) >= 2:
        out.append(chart_donut("effort_by_layer", "Effort by layer", list(by_layer.items())))
    blast = [b for b in (ctx.get("blast") or []) if isinstance(b, dict)]
    if blast:
        out.append(chart_hbar("blast_radius", "Blast radius — files per directory",
                              [(str(b.get("path", "")), b.get("files", 0) or 0) for b in blast], " files"))
    if len(steps) >= 3:
        out.append(chart_gantt(plan))
    if any((s.get("risk") or {}).get("level") in ("medium", "high") for s in steps):
        out.append(chart_risk(plan))
    for s in steps:
        info = s.get("infographic")
        if isinstance(info, dict) and isinstance(info.get("data"), list) and info["data"]:
            data = [(str(r[0]), r[1]) for r in info["data"]]
            key = "step:" + s["id"]
            if info.get("type") == "line":
                out.append(chart_line(key, str(info.get("title", "")), data))
            elif info.get("type") == "pie":
                out.append(chart_donut(key, str(info.get("title", "")), data))
            else:
                out.append(chart_bar(key, str(info.get("title", "")), data, alt=True))
    return "\n".join(out)


# ─────────────────────────────────── diff ───────────────────────────────────────
def _flat(obj, prefix: str = "") -> dict:
    """One level of nesting is enough for the "what changed" panel: files.modify, red.run, …"""
    if isinstance(obj, dict) and prefix == "":
        out = {}
        for k, v in obj.items():
            if isinstance(v, dict):
                for k2, v2 in v.items():
                    out[f"{k}.{k2}"] = v2
            else:
                out[k] = v
        return out
    return obj


def diff(a: dict, b: dict) -> dict:
    sa, sb = step_index(a), step_index(b)
    changed: dict[str, list[str]] = {}
    for sid in sb:
        if sid in sa:
            fa, fb = _flat(sa[sid]), _flat(sb[sid])
            fields = sorted(k for k in set(fa) | set(fb) if fa.get(k) != fb.get(k))
            if fields:
                changed[sid] = fields
    plan_fields = sorted(k for k in set(a) | set(b) if k != "steps" and a.get(k) != b.get(k))
    return {"from": a.get("version"), "to": b.get("version"),
            "added": [sid for sid in sb if sid not in sa],
            "removed": [sid for sid in sa if sid not in sb],
            "changed": changed, "plan": plan_fields}


# ────────────────────────────────── plan.html ───────────────────────────────────
def inline_json(obj) -> str:
    """JSON for a <script type="application/json">: `</` and `<!--` can never end or confuse the
    element, and both replacements stay valid JSON."""
    return json.dumps(obj, ensure_ascii=False, sort_keys=True, separators=(",", ":")) \
        .replace("</", "<\\/").replace("<!--", "<\\u0021--")


def render_html(plan: dict, theme: str = "auto", static: bool = False, mermaid: bool = False,
                transport: str = "auto") -> str:
    md = render_md(plan)
    graph = None
    if mermaid:
        graph = mermaid_via_mmdc(mermaid_source(plan))
    if graph is None:
        graph = wave_graph_svg(plan)
    md_html = md_to_html(md, graph)
    initial = "dark" if theme == "dark" else "light"
    slots = {"TITLE": esc(plan.get("title", "")), "THEME": initial, "THEME_MODE": theme,
             "REVIEW_MODE": "static" if static else transport, "CHARTS": charts_html(plan),
             "PLAN_MD_HTML": md_html, "PLAN_MD_RAW": inline_json(md), "PLAN_JSON": inline_json(plan)}
    # One pass over the template: a placeholder-shaped string inside plan text is never re-expanded.
    return re.sub(r"@@([A-Z_]+)@@", lambda m: slots[m.group(1)], TEMPLATE)


