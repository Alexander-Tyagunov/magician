/* ---------- player ---------- */
function dwellFor(i){ if(i===0) return 6000/speed; const s=items[i]; const words=((s.intent||'')+' '+(s.red.test||'')+' '+(s.green.sketch||'')+' '+s.verify.join(' ')).split(/\s+/).length; return Math.min(10,Math.max(4,4+0.5*words/40))*1000/speed }
function nextPlayable(i){for(let k=i+1;k<n;k++){if(items[k].review&&items[k].review.status==='deferred') continue; return k} return i}
function go(i){cur=Math.max(0,Math.min(n-1,i)); render(); if(playing) armDwell()}
function render(){const hs=$('#helperstep'); if(hs) hs.textContent=cur===0?'context':items[cur].id; renderHeader();renderTimeline();updateMap();renderDetail(); $('#progress').textContent=cur===0?'Step 0 / '+(n-1)+' · context':'Step '+cur+' / '+(n-1)+' · '+items[cur].id+' '+(items[cur].layer||'')}
function armDwell(){clearTimeout(timer); cancelAnimationFrame(raf); dwellLen=dwellFor(cur); dwellStart=performance.now(); timer=setTimeout(()=>{const nx=nextPlayable(cur); if(nx>cur) go(nx); else setPlaying(false)},dwellLen); const b=document.querySelector('.tl[aria-current="step"] .bar'); if(b&&!reduced){(function tick(){const k=Math.min(1,(performance.now()-dwellStart)/dwellLen); b.style.width=(k*100)+'%'; if(k<1&&playing) raf=requestAnimationFrame(tick)})()}}
function setPlaying(p){playing=p; $('#play').textContent=p?'❚❚ Pause':'▶ Play'; $('#play').setAttribute('aria-pressed',p); if(p){ if(cur===n-1) cur=0; render(); armDwell()} else {clearTimeout(timer); cancelAnimationFrame(raf); const b=document.querySelector('.tl .bar'); if(b) b.style.width='0'}}
$('#play').onclick=()=>setPlaying(!playing); $('#prev').onclick=()=>go(cur-1); $('#next').onclick=()=>go(cur+1); $('#restart').onclick=()=>{setPlaying(false);go(0)};
$('#speed').onclick=()=>{speed=speed===1?2:speed===2?0.5:1; $('#speed').textContent='Speed '+speed+'×'; if(playing) armDwell()};
$('#helpbtn').onclick=()=>{const h=$('#help'); const o=h.hasAttribute('open'); if(o)h.removeAttribute('open'); else h.setAttribute('open',''); $('#helpbtn').setAttribute('aria-expanded',!o)};
$('#theme').onchange=e=>{root.dataset.theme=e.target.value};
if(root.dataset.themeMode==='auto'&&matchMedia('(prefers-color-scheme: dark)').matches){root.dataset.theme='dark'}
$('#theme').value=root.dataset.theme;

/* ---------- sheet + toast ---------- */
function sheet({title,text,fields,ok,onok}){const s=$('#sheet'); $('#sheet-title').textContent=title; $('#sheet-text').textContent=text; $('#sheet-fields').innerHTML=fields||''; $('#sheet-ok').textContent=ok||'Send'; s.setAttribute('open',''); const f=s.querySelector('textarea,input'); if(f) f.focus(); else $('#sheet-ok').focus(); $('#sheet-ok').onclick=()=>{if(onok()!==false) close()}; $('#sheet-cancel').onclick=close; function close(){s.removeAttribute('open'); $('#detail').focus()}}
function trap(e){if(e.key!=='Tab') return; const f=Array.from(e.currentTarget.querySelectorAll('button,[href],input,select,textarea,[tabindex]:not([tabindex="-1"])')).filter(x=>!x.disabled&&x.getClientRects().length); if(!f.length) return; const first=f[0],last=f[f.length-1]; if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()} else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}
$('#sheet').addEventListener('keydown',trap); $('#mddlg').addEventListener('keydown',trap);
$('#sheet').addEventListener('keydown',e=>{if(e.key==='Escape') $('#sheet-cancel').click(); if(e.key==='Enter'&&e.target.tagName==='TEXTAREA'&&!e.shiftKey){e.preventDefault();$('#sheet-ok').click()}});
function toast(m){const t=$('#toast'); t.textContent=m; t.classList.add('show'); clearTimeout(t._t); t._t=setTimeout(()=>t.classList.remove('show'),3200)}
function copyText(text,label){const done=()=>toast((label||'Copied')+' — paste it into the Claude session'); const fail=()=>{toast('Clipboard refused by the browser — copy the line from the helper panel'); helperSay('sys',text)}; if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(done,fail)} else fail()}

/* ---------- events: §6.2 schema; sent by the transport, or composed as a chat line ---------- */
const log=[];
function describe(ev){const t=ev.type; return t==='step.review'?ev.step+' → '+ev.status:t==='step.change_request'?'['+ev.step+'] '+ev.text:t==='plan.change_request'?'[plan] '+ev.text:t==='step.edit'?'['+ev.step+'] edit '+Object.keys(ev.fields||{}).join(', ')+': '+Object.values(ev.fields||{}).join(' ').slice(0,200):t==='plan.approved'?'plan v'+ev.v+' approved ('+Object.keys(ev.steps||{}).length+' steps)':t==='plan.rejected'?'plan v'+ev.v+' rejected: '+ev.reason:t}
function emit(ev){
  ev.id=log.length+1; ev.v=PLAN.version; log.push(ev);
  helperSay('you',describe(ev),ev.type);
  if(!isLive()) return ev;
  if(link.stateVersion>PLAN.version){helperSay('sys','Not sent — the plan moved to v'+link.stateVersion+' while you were reviewing ('+ev.type+' carried v'+ev.v+'); the new version is loading.'); return ev}
  if(link.readOnly){helperSay('sys','Read-only view — '+ev.type+' was not sent.'); return ev}
  ev.ts=new Date().toISOString();
  const body=JSON.stringify(ev);
  if(body.length>8192){helperSay('sys','Not sent — the event is over 8 KB; shorten the text.'); toast('Event too large (over 8 KB)'); return ev}
  if(link.kind==='pending'){link.pending.push(ev); return ev}
  if(link.kind==='local') sendLocal(ev,body); else sendArtifact(ev);
  if(REVISING_TYPES.includes(ev.type)) beginRevising(ev.step||null);
  return ev;
}
function sendLocal(ev,body){
  fetch(liveUrl('events'),{method:'POST',headers:{'content-type':'application/json'},body}).then(r=>{
    if(!r.ok){helperSay('sys','The companion refused '+ev.type+' ('+r.status+')'); toast('The companion refused the event ('+r.status+')'); if(REVISING_TYPES.includes(ev.type)&&revising&&!revising.confirmed){endRevising(); render()} startPolling(0); return}
    return r.json().then(j=>{if(j&&j.id!=null) ev.server_id=j.id},()=>{}).then(()=>{if(REVISING_TYPES.includes(ev.type)) startPolling(2000)});
  },()=>{helperSay('sys','Could not reach the companion — reply in chat instead'); toast('Could not reach the companion — reply in chat instead'); if(REVISING_TYPES.includes(ev.type)&&revising&&!revising.confirmed){endRevising(); render()}});
}
function sendArtifact(ev){
  const doc=Object.assign({},ev);
  link.queue=link.queue.then(()=>link.db.collection('events').add(doc)).then(ref=>{ev.server_id=ref.id},e=>{dbError(e,'send '+ev.type); if(REVISING_TYPES.includes(ev.type)&&revising&&!revising.confirmed){endRevising(); render()}});
}
function dbError(e,what){
  const code=e&&typeof e.code==='string'?e.code:'unavailable';
  if(code==='invalid_argument'||code==='transform_error') setReadOnly('This view cannot write to the artifact database ('+code+') — the controls are read-only; comment on the artifact instead.');
  else if(code==='revoked'||code==='not_granted'||code==='capability_disabled'||code==='capability_removed') setReadOnly('The artifact database is not available in this view ('+code+') — read-only.');
  else if(code==='quota_exceeded') helperSay('sys','The artifact database is full — '+String(e.message||'').slice(0,200)+'. Ask the owner to delete this artifact after the review.');
  else helperSay('sys','Could not '+what+' ('+code+')'+(e&&e.message?': '+String(e.message).slice(0,200):''));
}
function setReadOnly(msg){if(!link.readOnly){link.readOnly=true; helperSay('sys',msg)} render()}

/* ---------- revising indicator (§5.4) ---------- */
function beginRevising(step,startedAt){
  const s=step&&byId[step]; if(s) s.review.status='revising';
  if(!revising||revising.step!==(step||'plan')) revising={step:step||'plan',started:isFinite(startedAt)?startedAt:Date.now(),confirmed:false,waiting:false};
  if(isFinite(startedAt)){revising.started=startedAt; revising.confirmed=true}
  setPlaying(false); render();
}
function endRevising(){if(!revising) return; const s=byId[revising.step]; if(s&&s.review.status==='revising') s.review.status='pending'; revising=null}
setInterval(()=>{ if(!revising) return; const el=$('#elapsed'); if(el) el.textContent=elapsedText(); if(!revising.waiting&&Date.now()-revising.started>WAIT_MS){revising.waiting=true; helperSay('sys','Waiting for Claude — check the session (no revision for 10 min)'); render()} },1000);

/* ---------- state (state.json / state document): the same shape on every transport ---------- */
function applyState(st){
  if(!st||typeof st!=='object') return;
  const ver=Number(st.version)||0; if(ver) link.stateVersion=ver;
  if(typeof st.status==='string'&&ver>=PLAN.version&&(!link.sentFinal||ver>PLAN.version||st.status==='approved'||st.status==='rejected')) PLAN.status=st.status;
  const rv=st.revising&&typeof st.revising==='object'&&st.revising.step?st.revising:null;
  if(st.steps&&typeof st.steps==='object'){Object.keys(st.steps).forEach(id=>{const s=byId[id]; const v=st.steps[id]; if(!s||v==null) return; const status=typeof v==='string'?v:(v.review||v.status); if(rv&&String(rv.step)===id) return; if(status==='revising'){beginRevising(id,revising&&revising.step===id?revising.started:Date.now()); return} if(revising&&!revising.confirmed&&revising.step===id) return; if(status&&['pending','approved','deferred','edited','changed'].includes(status)) s.review.status=status})}
  if(Array.isArray(st.changed)) st.changed.forEach(id=>{const s=byId[id]; if(s&&s.review.status!=='deferred'&&s.review.status!=='revising') s.review.status='changed'});
  if(rv){const t=Date.parse(rv.started_at); beginRevising(String(rv.step),isFinite(t)?t:undefined)}
  else if(revising&&revising.confirmed&&ver<=PLAN.version){endRevising()}
