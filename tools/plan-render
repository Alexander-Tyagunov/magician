# ─────────────────────────── plan.workflow.js (Claude Code Workflow) ───────────────────────────
# A Workflow script is JavaScript run by the Workflow tool: `meta` must be the first statement and a
# pure literal; `phase()`, `log()`, `agent(prompt, opts)` and `parallel([thunks])` are the API;
# Date.now(), Math.random(), new Date() and dynamic import() throw in that runtime, so the generator
# never emits them and the sanity check refuses a file that carries one outside a string.
FORBIDDEN_JS = ("Date.now(", "Math.random(", "new Date(", "import(")
MAX_SUMMARY = 1200
STALL_MS = 1800000


def js_str(s: str) -> str:
    """A JSON string literal is a valid JS string literal; `</` is escaped so the file could also sit
    inside an HTML page, and U+2028/2029 so it stays a single line."""
    return json.dumps(str(s), ensure_ascii=False).replace("</", "<\\/") \
        .replace("\u2028", "\\u2028").replace("\u2029", "\\u2029")


def js_lines(text: str, indent: str = "    ") -> str:
    """A multi-line prompt as one concatenation of per-line string literals (readable in the file)."""
    lines = text.rstrip("\n").split("\n")
    return (" +\n" + indent).join(js_str(line + ("\n" if i < len(lines) - 1 else "")) for i, line in enumerate(lines))


def ordered_in_wave(plan: dict, wave: dict) -> tuple[list[dict], list[dict]]:
    """Active steps of a wave: the parallel ones (plan order) and the sequential ones in dependency
    order (a step after every same-wave step it depends on; ties keep plan order)."""
    by = step_index(plan)
    active = [by[sid] for sid in wave.get("steps", []) if sid in by and not is_deferred(by[sid])]
    par = [s for s in active if s.get("parallel")]
    seq = [s for s in active if not s.get("parallel")]
    ids = {s["id"] for s in seq}
    out: list[dict] = []
    placed: set[str] = set()
    pending = list(seq)
    while pending:
        progress = False
        for s in list(pending):
            needs = [d for d in (s.get("depends_on") or []) if d in ids and d not in placed]
            if not needs:
                out.append(s)
                placed.add(s["id"])
                pending.remove(s)
                progress = True
        if not progress:                      # a cycle slipped past check(): keep plan order
            out += pending
            break
    return par, out


def workflow_prompt(plan: dict, s: dict) -> str:
    nums = task_numbers(plan)
    cons = plan.get("constraints") or []
    deferred = {x["id"] for x in steps_of(plan) if is_deferred(x)}
    skipped = [d for d in (s.get("depends_on") or []) if d in deferred]
    o = [f"Execute ONE task of the approved plan \"{plan.get('title', '')}\" (plan v{plan.get('version', '')}, "
         f"feature {plan.get('feature', '')}) with strict TDD on the existing repo. You see none of the parent "
         "conversation — this prompt is complete. Read the repo's conventions first (CLAUDE.md, linter config) "
         "and match them. Write the failing test first, make it pass, refactor; run the task's verify commands; "
         "commit exactly once with the message below. Do NOT push, open a PR, or touch files outside this task's "
         "Files list.",
         "",
         "## Global Constraints",
         "Every task inherits these — do not restate per task."]
    o += [f"- {c}" for c in cons] or ["- (none)"]
    if skipped:
        o += ["", f"Note: {', '.join(skipped)} is deferred this run; treat its outputs as absent."]
    o += ["", task_block(plan, s).rstrip("\n"), "",
          f"RETURN JSON: {{task:\"{s['id']}\" (Task {nums[s['id']]}), green (bool), commit (sha or subject), "
          f"files_changed[], summary (≤ {MAX_SUMMARY} chars, distilled — no logs), obstacles[] "
          "(lore/obstacles.md fields: STATUS, OBSTACLE, BLOCKER, SEVERITY, WORKAROUND, RECURRENCE, SCOPE, NEXT; "
          "empty when clean)}"]
    return "\n".join(o)


def render_workflow(plan: dict) -> str:
    steps = steps_of(plan)
    active = [s for s in steps if not is_deferred(s)]
    deferred = [s for s in steps if is_deferred(s)]
    waves = [w for w in plan.get("waves", []) if isinstance(w, dict)]
    phases = []
    for w in waves:
        par, seq = ordered_in_wave(plan, w)
        if par or seq:
            phases.append({"title": f"{w['id']} {w.get('title', '')}".strip(),
                           "detail": f"{len(par)} parallel, {len(seq)} sequential"})
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", str(plan.get("feature", "plan"))).strip("-") or "plan"
    desc = (f"{plan.get('title', '')} — plan v{plan.get('version', '')}: {len(active)} tasks in {len(phases)} waves"
            + (f", {len(deferred)} deferred" if deferred else ""))
