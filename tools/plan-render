def write_atomic(path: str, data: str) -> None:
    d = os.path.dirname(os.path.abspath(path)) or "."
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".plan-render.", dir=d)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as fh:
            fh.write(data)
        um = os.umask(0)
        os.umask(um)
        os.chmod(tmp, 0o666 & ~um)   # mkstemp gives 0600; these files are committed like specs
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def cmd_check(args) -> int:
    plan, raw = load(args.plan)
    problems = check(plan, raw)
    for p in problems:
        print(p)
    if problems:
        print(f"plan-render: {len(problems)} violation(s) in {args.plan}", file=sys.stderr)
        return 2
    _warn(plan)
    print(f"ok: {args.plan} is a valid {SCHEMA} plan "
          f"(v{plan.get('version')}, {len(steps_of(plan))} steps, {len(plan.get('waves', []))} waves)")
    return 0


def _checked(args) -> dict:
    plan, raw = load(args.plan)
    problems = check(plan, raw)
    if problems:
        for p in problems:
            print(p)
        print(f"plan-render: {len(problems)} violation(s) in {args.plan} — nothing rendered", file=sys.stderr)
        sys.exit(2)
    _warn(plan)
    return plan


def cmd_md(args) -> int:
    plan = _checked(args)
    out = render_md(plan)
    if args.output:
        write_atomic(args.output, out)
    else:
        sys.stdout.write(out)
    return 0


def cmd_html(args) -> int:
    plan = _checked(args)
    out = render_html(plan, theme=args.theme, static=args.static, mermaid=args.mermaid, transport=args.transport)
    if args.output:
        write_atomic(args.output, out)
    else:
        sys.stdout.write(out)
    return 0


def checked_workflow(plan: dict) -> str:
    """Render the Workflow script and refuse to hand back one that fails the sanity checks."""
    out = render_workflow(plan)
    problems = js_sanity(out)
    nc = node_check(out)
    if nc:
        problems.append(f"workflow: node --check failed: {nc.splitlines()[-1] if nc.strip() else nc}")
    if problems:
        for p in problems:
            print(p)
        print(f"plan-render: {len(problems)} violation(s) in the generated workflow — nothing written", file=sys.stderr)
        sys.exit(2)
    return out


def cmd_workflow(args) -> int:
    plan = _checked(args)
    out = checked_workflow(plan)
    if args.output:
        write_atomic(args.output, out)
    else:
        sys.stdout.write(out)
    return 0


def cmd_diff(args) -> int:
    a, _ = load(args.a)
    b, _ = load(args.b)
    print(json.dumps(diff(a, b), indent=2, ensure_ascii=False))
    return 0


def _warn(plan: dict) -> None:
    for w in warnings_of(plan):
        print(f"plan-render: warning: {w}", file=sys.stderr)


def newest_history_version(hist: str) -> int:
    best = 0
    if os.path.isdir(hist):
        for name in os.listdir(hist):
            m = re.match(r"^plan\.v(\d+)(\.rejected)?\.json$", name)
            if m:
                best = max(best, int(m.group(1)))
    return best


def cmd_all(args) -> int:
    plan, raw = load(args.plan)
    problems = check(plan, raw)
    folder = os.path.dirname(os.path.abspath(args.plan))
    hist = os.path.join(folder, "history")
    snap = os.path.join(hist, f"plan.v{plan.get('version')}.json")
    if not problems:
        if os.path.islink(hist):
            problems.append("history: history/ is a symbolic link; refusing to write through it")
        else:
            newest = newest_history_version(hist)
            if plan["version"] < newest:
                problems.append(f"version: v{plan['version']} is lower than history/plan.v{newest}.json; bump the version")
            if os.path.exists(snap):
                with open(snap, "rb") as fh:
                    if fh.read() != raw:
                        problems.append(f"version: history/plan.v{plan['version']}.json already holds a different "
                                        f"v{plan['version']}; bump the version before rendering a changed plan")
    if problems:
        for p in problems:
            print(p)
        print(f"plan-render: {len(problems)} violation(s) — nothing rendered", file=sys.stderr)
        return 2
    _warn(plan)
    md_text = render_md(plan)                      # render everything first, then write all files
    html_text = render_html(plan, theme=args.theme, static=args.static, mermaid=args.mermaid, transport=args.transport)
    wf_text = checked_workflow(plan)
    md_path = os.path.join(folder, "plan.md")
    html_path = os.path.join(folder, "plan.html")
    wf_path = os.path.join(folder, "plan.workflow.js")
    write_atomic(md_path, md_text)
    write_atomic(html_path, html_text)
    write_atomic(wf_path, wf_text)
    os.makedirs(hist, exist_ok=True)
    write_atomic(snap, raw.decode("utf-8"))
    for p in (md_path, html_path, wf_path, snap):
        print(_shown_path(p))
    return 0


def _shown_path(p: str) -> str:
    """A written path relative to the working folder. Both sides are resolved first, so a
    symlinked folder (macOS /var -> /private/var, a symlinked project) does not print ../../.."""
    try:
        return os.path.relpath(os.path.realpath(p), os.path.realpath(os.getcwd()))
    except ValueError:                       # another drive on Windows
        return os.path.abspath(p)


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="plan-render", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog="\n".join(__doc__.split("\n\n")[1:]))
    sub = ap.add_subparsers(dest="cmd", metavar="<command>")
    p = sub.add_parser("check", help="validate plan.json; exit 2 with one line per violation")
    p.add_argument("plan")
    p.set_defaults(fn=cmd_check)
    p = sub.add_parser("md", help="render plan.md")
    p.add_argument("plan")
    p.add_argument("-o", "--output")
    p.set_defaults(fn=cmd_md)
    for name, fn in (("html", cmd_html), ("all", cmd_all)):
        p = sub.add_parser(name, help="render plan.html" if name == "html"
                           else "check, then plan.md + plan.html + history/plan.v<version>.json next to the json")
        p.add_argument("plan")
        if name == "html":
            p.add_argument("-o", "--output")
        p.add_argument("--theme", choices=("light", "dark", "auto"), default="auto",
                       help="initial theme; auto follows prefers-color-scheme (default)")
        p.add_argument("--transport", choices=("auto", "local", "artifact", "static"), default="auto",
                       help="how the review toolbar reaches the session: auto (default), local companion, "
                            "artifact db capability, or static chat lines")
        p.add_argument("--static", action="store_true", help="pin the page to static review mode (--transport static)")
        p.add_argument("--mermaid", action="store_true", help="draw the wave graph with mmdc when on PATH")
        p.set_defaults(fn=fn)
    p = sub.add_parser("workflow", help="render plan.workflow.js (a Claude Code Workflow script; deferred steps omitted)")
    p.add_argument("plan")
    p.add_argument("-o", "--output")
    p.set_defaults(fn=cmd_workflow)
    p = sub.add_parser("diff", help="JSON summary of what changed between two plan versions")
    p.add_argument("a")
    p.add_argument("b")
    p.set_defaults(fn=cmd_diff)
    args = ap.parse_args(argv)
    if not args.cmd:
        ap.print_help()
        return 64
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
