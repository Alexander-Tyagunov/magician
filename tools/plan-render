         f"  name: {js_str(name + '-plan')},",
         f"  description: {js_str(desc)},",
         "  phases: [",
         *[f"    {{ title: {js_str(p['title'])}, detail: {js_str(p['detail'])} }}," for p in phases],
         "  ],",
         "}",
         "",
         f"// Generated by plan-render from plan.json ({SCHEMA} v{plan.get('version', '')}, sha256:{plan_hash(plan)}).",
         "// One phase per wave; parallel() for the steps marked Parallel: YES, then the sequential steps in",
         "// dependency order; deferred steps are omitted. Pass to the Workflow tool as {script}. No Date.now(),",
         "// Math.random(), new Date() or import() — they throw in the Workflow runtime.",
         "",
         "// Return budget (skills/weave/references/template.md): bounded strings, files_changed[], obstacles[].",
         "const S = (n) => ({ type: 'string', maxLength: n })",
         "const OBSTACLE = { type: 'object', additionalProperties: false,   // lore/obstacles.md, 8 fields",
         "  properties: { STATUS: { type: 'string', enum: ['BLOCKED', 'DEGRADED', 'NEEDS_CONTEXT'] }, OBSTACLE: S(200),",
         "    BLOCKER: S(400), SEVERITY: { type: 'string', enum: ['Critical', 'High', 'Medium', 'Low'] }, WORKAROUND: S(400),",
         "    RECURRENCE: { type: 'string', enum: ['First-seen', 'Recurring', 'Systemic'] }, SCOPE: S(200), NEXT: S(300) },",
         "  required: ['STATUS', 'OBSTACLE', 'BLOCKER', 'SEVERITY', 'RECURRENCE', 'SCOPE', 'NEXT'] }",
         "const OBSTACLES = { type: 'array', maxItems: 8, items: OBSTACLE }",
         "const FILES = { type: 'array', maxItems: 200, items: S(300) }",
         "const RESULT = { type: 'object', additionalProperties: false,",
         f"  properties: {{ task: S(80), green: {{ type: 'boolean' }}, commit: S(64), files_changed: FILES, summary: S({MAX_SUMMARY}), obstacles: OBSTACLES }},",
         "  required: ['task', 'green', 'summary', 'obstacles'] }",
         f"const STALL_MS = {STALL_MS}   // per-agent silence budget before a restart",
         "",
         "const results = {}",
         "function task(id, phaseTitle, prompt) {",
         "  return agent(prompt, { label: id, phase: phaseTitle, schema: RESULT, effort: 'medium', stallMs: STALL_MS })",
         "    .then((r) => { results[id] = r; if (!r || !r.green) log('⚠ ' + id + ': not green — left for manual follow-up'); return r })",
         "}",
         ""]
    for w in waves:
        par, seq = ordered_in_wave(plan, w)
        if not (par or seq):
            continue
        title = f"{w['id']} {w.get('title', '')}".strip()
        o += [f"// ── {title} ──", f"phase({js_str(title)})",
              f"log({js_str(f'{title}: ' + ', '.join(s['id'] for s in par + seq))})"]
        if par:
            o.append("await parallel([")
            for s in par:
                o += [f"  () => task({js_str(s['id'])}, {js_str(title)},", "    " + js_lines(workflow_prompt(plan, s)) + "),"]
            o.append("])")
        for s in seq:
            o += [f"await task({js_str(s['id'])}, {js_str(title)},", "  " + js_lines(workflow_prompt(plan, s), "  ") + ")"]
        o.append(f"log({js_str(title + ' done')})")
        o.append("")
    if deferred:
        o.append("// Deferred — not executed this run: " + ", ".join(s["id"] for s in deferred))
        o.append("")
    o += ["return {",
          f"  plan: {js_str(str(plan.get('feature', '')))}, version: {int(plan.get('version', 0) or 0)},",
          "  tasks: Object.keys(results).map((id) => ({ id, green: !!(results[id] && results[id].green), commit: results[id] && results[id].commit })),",
          "  obstacles: Object.keys(results).flatMap((id) => ((results[id] && results[id].obstacles) || []).map((o) => ({ task: id, ...o }))),",
          f"  deferred: [{', '.join(js_str(s['id']) for s in deferred)}],",
          "}"]
    return "\n".join(o) + "\n"


def strip_js_strings(src: str) -> str:
    """Code with string literals and comments blanked (quotes kept), so a token scan and a bracket
    balance see only code. Template literals keep their `${…}` holes as code."""
    out: list[str] = []
    i, n = 0, len(src)
    while i < n:
        c = src[i]
        if c in "\"'":
            q = c
            out.append(q)
            i += 1
            while i < n and src[i] != q:
                if src[i] == "\\":
                    i += 1
                if i < n and src[i] == "\n":
                    return "".join(out) + "\n<<unterminated string>>"
                i += 1
            out.append(q)
            i += 1
        elif c == "`":
            out.append("`")
            i += 1
            while i < n and src[i] != "`":
                if src[i] == "\\":
                    i += 2
                    continue
                if src.startswith("${", i):
                    depth = 0
                    while i < n:
                        if src[i] == "{":
                            depth += 1
                        elif src[i] == "}":
                            depth -= 1
                            if depth == 0:
                                out.append(src[i])
                                i += 1
                                break
                        out.append(src[i])
                        i += 1
                    continue
                i += 1
            out.append("`")
            i += 1
        elif src.startswith("//", i):
            while i < n and src[i] != "\n":
                i += 1
        elif src.startswith("/*", i):
            j = src.find("*/", i + 2)
            i = n if j < 0 else j + 2
        else:
            out.append(c)
            i += 1
    return "".join(out)


def js_sanity(src: str) -> list[str]:
    """Stdlib check of a generated Workflow script: no forbidden runtime calls outside strings,
    balanced brackets, every string literal closed, `export const meta` first."""
    problems: list[str] = []
    code = strip_js_strings(src)
    if "<<unterminated string>>" in code:
        problems.append("workflow: unterminated string literal")
    for tok in FORBIDDEN_JS:
        if tok in code:
            problems.append(f"workflow: forbidden token {tok!r} outside a string (it throws in the Workflow runtime)")
    pairs = {")": "(", "]": "[", "}": "{"}
    stack: list[str] = []
    for ch in code:
        if ch in "([{":
            stack.append(ch)
        elif ch in pairs:
            if not stack or stack[-1] != pairs[ch]:
                problems.append(f"workflow: unbalanced {ch!r}")
                break
            stack.pop()
    if stack:
        problems.append(f"workflow: unclosed {stack[-1]!r}")
    if not src.startswith("export const meta = {"):
        problems.append("workflow: `export const meta` must be the first statement")
    for q in ('"', "'", "`"):
        if code.count(q) % 2:
            problems.append(f"workflow: odd number of {q} quotes")
    return problems


def checkable_js(src: str) -> str:
    """The Workflow runtime runs the body after `meta` inside an async function (so top-level `return`
    and `await` are legal there); `node --check` parses a module, so the same body is wrapped the
    same way before checking. Line numbers shift by one."""
    end = src.find("\n}\n")
    if not src.startswith("export const meta = {") or end < 0:
        return src
    head, body = src[:end + 3], src[end + 3:]
    return head + "async function __workflow(args, budget, agent, parallel, pipeline, phase, log) {\n" + body + "}\n"


def node_check(src: str) -> str | None:
    """`node --check` of the wrapped script when node exists; None when node is absent, "" when ok."""
    node = shutil.which("node")
    if not node:
        return None
    fd, tmp = tempfile.mkstemp(prefix=".plan-render.", suffix=".mjs")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(checkable_js(src))
        p = subprocess.run([node, "--check", tmp], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as e:
        return f"node --check could not run: {e}"
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass
    return "" if p.returncode == 0 else (p.stderr.strip() or f"node --check exit {p.returncode}")


