    <dl><dt><span class="kbd">Space</span></dt><dd>Play / pause</dd><dt><span class="kbd">←</span> <span class="kbd">→</span></dt><dd>Previous / next step</dd><dt><span class="kbd">R</span></dt><dd>Restart</dd><dt><span class="kbd">S</span></dt><dd>Cycle speed</dd><dt><span class="kbd">A</span></dt><dd>Approve step</dd><dt><span class="kbd">C</span></dt><dd>Request change</dd><dt><span class="kbd">E</span></dt><dd>Edit step</dd><dt><span class="kbd">D</span></dt><dd>Defer step</dd><dt><span class="kbd">H</span></dt><dd>Helper panel</dd><dt><span class="kbd">?</span></dt><dd>This help</dd><dt><span class="kbd">Esc</span></dt><dd>Close sheet</dd></dl>
