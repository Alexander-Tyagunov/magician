def _version():
    try:
        with open(PLUGIN_JSON, encoding="utf-8") as f:
            return str(json.load(f).get("version", "0"))
    except Exception:
        return "0"


SERVER_INFO = {"name": "magician-kg", "title": "magician knowledge graph", "version": _version()}


def clip(s, n=MAX_STR):
    s = "" if s is None else str(s)
    s = s.replace("\r", " ").replace("\n", " ")
    return s if len(s) <= n else s[: n - 1] + "…"


# ─────────────────────────── read-only engine access ───────────────────────
def ro_connect(db_path):
    """Open the graph DB read-only: the URI mode refuses writes and query_only refuses them again."""
    uri = "file:" + db_path.replace("?", "%3f").replace("#", "%23") + "?mode=ro"
    cx = sqlite3.connect(uri, uri=True, timeout=15)
    cx.execute("PRAGMA query_only=ON")
    return cx


class Engine:
    """Loads tools/kg as a module and swaps its connect() for the read-only one.

    Only pure read paths of the engine are called: query, neighbors, blast, status_data and
    stale_files. The result cache (which writes) and the index builder are never used."""

    def __init__(self, repo):
        self.repo = os.path.realpath(repo)
        self.mod = None
        self.ix = None
        self.ix_key = None

    def load(self):
        if self.mod is None:
            from importlib.machinery import SourceFileLoader
            import importlib.util
            prev = os.getcwd()
            os.chdir(self.repo)                    # kg derives the repo root from the cwd at import
            try:
                loader = SourceFileLoader("magician_kg_engine", ENGINE_PATH)
                spec = importlib.util.spec_from_loader("magician_kg_engine", loader)
                mod = importlib.util.module_from_spec(spec)
                loader.exec_module(mod)
            finally:
                os.chdir(prev)
            mod.connect = lambda: ro_connect(mod.DB_PATH)
            self.mod = mod
        return self.mod

    def indexed(self):
        return os.path.exists(self.load().DB_PATH)

    def root(self):
        return self.load().ROOT

    def index(self):
        m = self.load()
        st = os.stat(m.DB_PATH)
        key = (m.load_meta().get("index_version"), st.st_mtime_ns)
        if self.ix is None or self.ix_key != key:
            if self.ix is not None:
                try:
                    self.ix.cx.close()
                except Exception:
                    pass
            self.ix, self.ix_key = m.Index(), key
        return self.ix

    def index_version(self):
        return self.load().load_meta().get("index_version")


